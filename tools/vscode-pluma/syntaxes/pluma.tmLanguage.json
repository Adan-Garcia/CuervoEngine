{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pluma",
  "scopeName": "source.pluma",
  "fileTypes": [
    "plm"
  ],
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#attributes"
        },
        {
          "include": "#names"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#braces"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.pluma",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.pluma"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.pluma"
            }
          },
          "patterns": [
            {
              "include": "#block_comment_nested"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.pluma",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.pluma"
            }
          }
        }
      ]
    },
    "block_comment_nested": {
      "name": "comment.block.pluma",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#block_comment_nested"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.raw.pluma",
          "begin": "\\br\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.pluma"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.pluma"
            }
          }
        },
        {
          "name": "string.quoted.triple.pluma",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.pluma"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.pluma"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.pluma",
              "match": "\\\\(?:[ntr\\\\\"0]|u\\{[0-9A-Fa-f]{1,6}\\})"
            },
            {
              "name": "invalid.illegal.escape.pluma",
              "match": "\\\\."
            },
            {
              "name": "constant.character.escape.brace.pluma",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.raw.pluma",
          "begin": "\\br\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.pluma"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.pluma"
            }
          }
        },
        {
          "name": "string.quoted.double.pluma",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.pluma"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.pluma"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.pluma",
              "match": "\\\\(?:[ntr\\\\\"0]|u\\{[0-9A-Fa-f]{1,6}\\})"
            },
            {
              "name": "invalid.illegal.escape.pluma",
              "match": "\\\\."
            },
            {
              "name": "constant.character.escape.brace.pluma",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.pluma",
      "contentName": "source.pluma.embedded",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.pluma"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.pluma"
        }
      },
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.pluma"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.pluma"
        }
      },
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.pluma",
          "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.attribute.pluma"
            },
            "2": {
              "name": "entity.name.function.decorator.pluma"
            }
          }
        }
      ]
    },
    "names": {
      "patterns": [
        {
          "name": "constant.other.symbol.pluma",
          "match": "(#)[A-Za-z_][A-Za-z0-9_]*",
          "captures": {
            "1": {
              "name": "punctuation.definition.symbol.pluma"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.pluma",
          "match": "\\b0x[0-9A-Fa-f_]+(?:[iu](?:8|16|32|64))?\\b"
        },
        {
          "name": "constant.numeric.binary.pluma",
          "match": "\\b0b[01_]+(?:[iu](?:8|16|32|64))?\\b"
        },
        {
          "name": "constant.numeric.float.pluma",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?|[eE][+-]?\\d[\\d_]*)(f32|f64|deg)?\\b",
          "captures": {
            "1": {
              "name": "keyword.other.unit.suffix.pluma"
            }
          }
        },
        {
          "name": "constant.numeric.integer.pluma",
          "match": "\\b\\d[\\d_]*([iu](?:8|16|32|64)|f32|f64|deg)?\\b",
          "captures": {
            "1": {
              "name": "keyword.other.unit.suffix.pluma"
            }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?<![.\\w])\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.pluma"
            },
            "2": {
              "name": "entity.name.function.pluma"
            }
          }
        },
        {
          "match": "(?<![.\\w])\\b(class|struct|enum|trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.$1.pluma"
            },
            "2": {
              "name": "entity.name.type.pluma"
            }
          }
        },
        {
          "match": "(?<![.\\w])\\b(signal)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.signal.pluma"
            },
            "2": {
              "name": "entity.name.function.signal.pluma"
            }
          }
        },
        {
          "match": "(?<![.\\w])\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.const.pluma"
            },
            "2": {
              "name": "variable.other.constant.pluma"
            }
          }
        },
        {
          "match": "(?<![.\\w])\\b(var)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.var.pluma"
            },
            "2": {
              "name": "variable.other.declaration.pluma"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.pluma",
          "match": "(?<![.\\w])\\b(?:if|else|match|for|foreach|in|while|loop|break|continue|return|step|await|yield|start|emit|defer)\\b"
        },
        {
          "name": "storage.type.pluma",
          "match": "(?<![.\\w])\\b(?:var|const|fn|class|struct|enum|trait|signal)\\b"
        },
        {
          "name": "storage.modifier.pluma",
          "match": "(?<![.\\w])\\b(?:extends|manual|unsafe|weak|pub|final|static|get|set)\\b"
        },
        {
          "name": "keyword.operator.memory.pluma",
          "match": "(?<![.\\w])\\b(?:new|alloc|free)\\b"
        },
        {
          "name": "keyword.operator.type.pluma",
          "match": "(?<![.\\w])\\b(?:is|as)\\b"
        },
        {
          "name": "constant.language.pluma",
          "match": "(?<![.\\w])\\b(?:true|false|null)\\b"
        },
        {
          "name": "variable.language.pluma",
          "match": "(?<![.\\w])\\b(?:self|super)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.pluma",
          "match": "\\b(?:int|float|bool|str|void|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|i?vec\\d{1,2})\\b"
        },
        {
          "name": "storage.type.primitive.pluma",
          "match": "(?:(?<=:\\s)|(?<=:)|(?<=->\\s)|(?<=<))name\\b"
        },
        {
          "name": "support.type.pluma",
          "match": "\\b(?:List|Map|Task|Signal|Result)\\b"
        },
        {
          "name": "entity.name.type.pluma",
          "match": "\\b[A-Z][A-Za-z0-9]*[a-z][A-Za-z0-9]*\\b"
        },
        {
          "name": "variable.other.constant.pluma",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        },
        {
          "name": "entity.name.type.parameter.pluma",
          "match": "\\b[A-Z]\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.pluma"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.pluma",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.null.pluma",
          "match": "\\?\\?|\\?\\."
        },
        {
          "name": "keyword.operator.range.pluma",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.comparison.pluma",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.compound.pluma",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>)="
        },
        {
          "name": "keyword.operator.logical.pluma",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.pluma",
          "match": "<<|>>|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.arithmetic.pluma",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.pluma",
          "match": "="
        },
        {
          "name": "keyword.operator.ternary.pluma",
          "match": "\\?"
        },
        {
          "name": "punctuation.separator.colon.pluma",
          "match": ":"
        },
        {
          "name": "punctuation.separator.pluma",
          "match": "[,;]"
        },
        {
          "name": "punctuation.accessor.pluma",
          "match": "\\."
        }
      ]
    }
  }
}
