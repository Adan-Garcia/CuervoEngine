# The EULA's version and text, taken from LICENSE.md at configure time
# (DESIGN.md 4.16 "EULA agreement"). LICENSE.md stays the only copy:
#
#   cuervo_eula_version()          sets CUERVO_EULA_VERSION ("0.1") and CUERVO_EULA_DATE
#                                  from the line "Version 0.1 (draft), 2026-10-18"; fails
#                                  the configure when LICENSE.md has no such line
#   cuervo_eula_embed(<out_dir>)   writes <out_dir>/cuervo/platform/eula_license.inc and
#                                  eula_notices.inc (LICENSE.md and THIRD_PARTY_NOTICES.md
#                                  as bytes, so the compiled editor shows them with no
#                                  source tree beside it)

macro(cuervo_eula_version)
    set(_license "${PROJECT_SOURCE_DIR}/LICENSE.md")
    set_property(DIRECTORY "${PROJECT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_license}")
    file(STRINGS "${_license}" _lines REGEX "^Version [0-9]+(\\.[0-9]+)*")
    list(GET _lines 0 _first)
    if(NOT _first MATCHES "^Version ([0-9]+(\\.[0-9]+)*)[^,]*(, *([0-9-]+))?")
        message(FATAL_ERROR "LICENSE.md has no 'Version <n.n>' line; the EULA version is read from it")
    endif()
    set(CUERVO_EULA_VERSION "${CMAKE_MATCH_1}")
    set(CUERVO_EULA_DATE "${CMAKE_MATCH_4}")
endmacro()

function(cuervo_eula_embed out_dir)
    foreach(pair "LICENSE.md|eula_license" "THIRD_PARTY_NOTICES.md|eula_notices")
        string(REPLACE "|" ";" parts "${pair}")
        list(GET parts 0 file)
        list(GET parts 1 name)
        set_property(DIRECTORY "${PROJECT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/${file}")
        file(READ "${PROJECT_SOURCE_DIR}/${file}" hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
        string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n" hex "${hex}")
        file(CONFIGURE OUTPUT "${out_dir}/cuervo/platform/${name}.inc" @ONLY CONTENT
             "// GENERATED by cmake/Eula.cmake from ${file}. Do not edit.\n@hex@0x00\n")
    endforeach()
endfunction()
