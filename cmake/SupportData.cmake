# Compiles docs/support.json (the support matrix, milestone 8.8) into a C++ include so the
# tier and export checks read the same data the documentation tables are generated from.
# Written at configure time with string(JSON); a change to the file re-runs CMake.
#
#   cuervo_generate_support_data(<output .inc>)

function(cuervo_generate_support_data out)
    set(json_file ${PROJECT_SOURCE_DIR}/docs/support.json)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${json_file})
    file(READ ${json_file} json)

    # Platform ids -> bit masks in cuervo::script::support::Target order.
    set(bit_linux 1)
    set(bit_windows 2)
    set(bit_web 4)

    function(_platform_mask list_json out_var)
        string(JSON n LENGTH "${list_json}")
        set(mask 0)
        if(n GREATER 0)
            math(EXPR last "${n} - 1")
            foreach(i RANGE ${last})
                string(JSON p GET "${list_json}" ${i})
                if(NOT DEFINED bit_${p})
                    message(FATAL_ERROR "docs/support.json: unknown platform '${p}'")
                endif()
                math(EXPR mask "${mask} | ${bit_${p}}")
            endforeach()
        endif()
        set(${out_var} ${mask} PARENT_SCOPE)
    endfunction()

    function(_bool value out_var)
        if(value)
            set(${out_var} true PARENT_SCOPE)
        else()
            set(${out_var} false PARENT_SCOPE)
        endif()
    endfunction()

    set(text "// Generated by cmake/SupportData.cmake from docs/support.json. Do not edit.\n")

    # Targets
    string(JSON nt LENGTH "${json}" targets)
    string(APPEND text "constexpr TargetEntry target_table[] = {\n")
    math(EXPR last "${nt} - 1")
    foreach(i RANGE ${last})
        string(JSON id GET "${json}" targets ${i} id)
        string(JSON name GET "${json}" targets ${i} name)
        string(JSON status GET "${json}" targets ${i} status)
        string(APPEND text "    {R\"SUP(${id})SUP\", R\"SUP(${name})SUP\", Status::${status}},\n")
    endforeach()
    string(APPEND text "};\n")

    # Entries
    string(APPEND text "constexpr Entry entry_table[] = {\n")
    string(JSON ns LENGTH "${json}" sections)
    math(EXPR lasts "${ns} - 1")
    foreach(s RANGE ${lasts})
        string(JSON ne LENGTH "${json}" sections ${s} entries)
        math(EXPR laste "${ne} - 1")
        foreach(i RANGE ${laste})
            string(JSON id GET "${json}" sections ${s} entries ${i} id)
            string(JSON name GET "${json}" sections ${s} entries ${i} name)
            string(JSON status GET "${json}" sections ${s} entries ${i} status)
            string(JSON tier GET "${json}" sections ${s} entries ${i} tier)
            string(JSON note GET "${json}" sections ${s} entries ${i} note)
            string(JSON plats GET "${json}" sections ${s} entries ${i} platforms)
            string(JSON desktop GET "${json}" sections ${s} entries ${i} desktop_only)
            string(JSON web GET "${json}" sections ${s} entries ${i} web)
            _platform_mask("${plats}" mask)
            _bool(${desktop} desktop_b)
            _bool(${web} web_b)
            string(APPEND text "    {R\"SUP(${id})SUP\", R\"SUP(${name})SUP\", Status::${status}, ${mask}, ${desktop_b}, ${web_b}, "
                "TierNeed::${tier}, R\"SUP(${note})SUP\"},\n")
        endforeach()
    endforeach()
    string(APPEND text "};\n")

    # RHI features as documented
    string(JSON nf LENGTH "${json}" rhi_features)
    math(EXPR lastf "${nf} - 1")
    string(APPEND text "constexpr RhiFeatureDoc rhi_feature_table[] = {\n")
    foreach(i RANGE ${lastf})
        string(JSON name GET "${json}" rhi_features ${i} name)
        string(JSON tier GET "${json}" rhi_features ${i} tier)
        string(JSON required GET "${json}" rhi_features ${i} required)
        _bool(${required} required_b)
        string(APPEND text "    {R\"SUP(${name})SUP\", TierNeed::${tier}, ${required_b}},\n")
    endforeach()
    string(APPEND text "};\n")

    # Tiers
    foreach(tier compatible full)
        string(JSON plats GET "${json}" tiers ${tier} platforms)
        _platform_mask("${plats}" mask_${tier})
    endforeach()
    string(JSON tex GET "${json}" tiers compatible limits max_texture_size)
    string(JSON msaa GET "${json}" tiers compatible limits max_msaa_samples)
    string(JSON ubo GET "${json}" tiers compatible limits max_uniform_block_size)
    string(JSON attrs GET "${json}" tiers compatible limits max_vertex_attributes)
    string(JSON align GET "${json}" tiers compatible limits uniform_offset_alignment)
    string(APPEND text "constexpr unsigned compatible_tier_platforms = ${mask_compatible};\n")
    string(APPEND text "constexpr unsigned full_tier_platforms = ${mask_full};\n")
    string(APPEND text "constexpr CompatibleLimitsDoc compatible_limits_doc = {${tex}, ${msaa}, ${ubo}, ${attrs}, ${align}};\n")

    file(GENERATE OUTPUT ${out} CONTENT "${text}")
endfunction()
