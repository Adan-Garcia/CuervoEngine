# The license and notices text, taken from LICENSE.md and THIRD_PARTY_NOTICES.md at configure time.
# LICENSE.md and THIRD_PARTY_NOTICES.md stay the only copies:
#
#   cuervo_license_embed(<out_dir>)   writes <out_dir>/cuervo/platform/license_text.inc and
#                                     notices_text.inc (LICENSE.md and THIRD_PARTY_NOTICES.md
#                                     as bytes, so the compiled editor shows them with no
#                                     source tree beside it)

function(cuervo_license_embed out_dir)
    foreach(pair "LICENSE.md|license_text" "THIRD_PARTY_NOTICES.md|notices_text")
        string(REPLACE "|" ";" parts "${pair}")
        list(GET parts 0 file)
        list(GET parts 1 name)
        set_property(DIRECTORY "${PROJECT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/${file}")
        file(READ "${PROJECT_SOURCE_DIR}/${file}" hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
        string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n" hex "${hex}")
        file(CONFIGURE OUTPUT "${out_dir}/cuervo/platform/${name}.inc" @ONLY CONTENT
             "// GENERATED by cmake/License.cmake from ${file}. Do not edit.\n@hex@0x00\n")
    endforeach()
endfunction()
