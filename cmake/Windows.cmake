# cuervo_windows_app(<target> [GUI])
#
# Windows-only setup for an executable (docs/WINDOWS.md): embeds
# cmake/windows/cuervo.manifest (UTF-8 active code page, PerMonitorV2 DPI
# awareness, long paths) and links cmake/windows/console.cpp (UTF-8 console
# output). GUI makes it a GUI-subsystem program that still enters through a
# plain `main` (no SDL_main.h, no WinMain), for players that shouldn't open a
# console window. A no-op on other platforms.
set(CUERVO_WINDOWS_DIR "${CMAKE_CURRENT_LIST_DIR}/windows")

function(cuervo_windows_app target)
    if(NOT WIN32)
        return()
    endif()
    cmake_parse_arguments(ARG "GUI" "" "" ${ARGN})
    target_sources(${target} PRIVATE "${CUERVO_WINDOWS_DIR}/console.cpp")
    # cl, clang-cl and clang++ targeting the MSVC runtime all link through CMake's
    # MSVC-style link step; MinGW-w64 links with GNU ld.
    if(MSVC OR CMAKE_CXX_SIMULATE_ID STREQUAL "MSVC")
        set(_msvc_link TRUE)
    else()
        set(_msvc_link FALSE)
    endif()
    if(_msvc_link)
        # A .manifest source: CMake merges it (mt) into the one manifest it embeds.
        target_sources(${target} PRIVATE "${CUERVO_WINDOWS_DIR}/cuervo.manifest")
    else()
        # GNU ld embeds resources only: an .rc naming the manifest by absolute
        # path (windres resolves relative names from its working directory).
        set(_rc "${CMAKE_BINARY_DIR}/generated/cuervo_manifest.rc")
        file(TO_NATIVE_PATH "${CUERVO_WINDOWS_DIR}/cuervo.manifest" _manifest)
        string(REPLACE "\\" "\\\\" _manifest "${_manifest}")
        file(CONFIGURE OUTPUT "${_rc}" CONTENT "// Generated by cmake/Windows.cmake\n1 24 \"${_manifest}\"\n" @ONLY)
        target_sources(${target} PRIVATE "${_rc}")
        set_property(SOURCE "${_rc}" APPEND PROPERTY OBJECT_DEPENDS "${CUERVO_WINDOWS_DIR}/cuervo.manifest")
    endif()
    if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        # MinGW-w64's GCC links its own default-manifest.o into every program, and
        # ld can't tell which of two same-language manifests to keep (".rsrc merge
        # failure"). -B finds an empty object of that name first.
        set(_nomanifest "${CMAKE_BINARY_DIR}/generated/no-default-manifest")
        if(NOT EXISTS "${_nomanifest}/default-manifest.o")
            file(MAKE_DIRECTORY "${_nomanifest}")
            file(WRITE "${_nomanifest}/empty.c" "/* replaces MinGW-w64's default-manifest.o (cmake/Windows.cmake) */\n")
            execute_process(COMMAND "${CMAKE_C_COMPILER}" -c empty.c -o default-manifest.o
                            WORKING_DIRECTORY "${_nomanifest}" RESULT_VARIABLE _rc_result)
            if(NOT _rc_result EQUAL 0)
                message(FATAL_ERROR "cuervo_windows_app: could not build an empty default-manifest.o")
            endif()
        endif()
        target_link_options(${target} PRIVATE "-B${_nomanifest}/")
    endif()
    if(ARG_GUI)
        set_target_properties(${target} PROPERTIES WIN32_EXECUTABLE ON)
        target_compile_definitions(${target} PRIVATE CUERVO_GUI_SUBSYSTEM=1)
        if(_msvc_link)
            # The MSVC runtime enters a GUI program through WinMain unless told otherwise.
            target_link_options(${target} PRIVATE "LINKER:/ENTRY:mainCRTStartup")
        endif()
        # MinGW-w64's runtime calls `main` under -mwindows already.
    endif()
endfunction()
