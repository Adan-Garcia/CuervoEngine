// Unit tests for the package (LANGUAGE.md 9.27): `cuervo-tools test
// examples/libs/tween`. Left out of games that use the package.

@test fn curves_start_at_zero_and_end_at_one() {
    for curve in [Ease.Linear, Ease.InQuad, Ease.OutQuad, Ease.InOutCubic] {
        assert(ease(curve, 0.0) == 0.0, "{curve} at 0")
        assert(ease(curve, 1.0) == 1.0, "{curve} at 1")
    }
}

@test fn ease_clamps_its_input() {
    assert(ease(Ease.Linear, -1.0) == 0.0)
    assert(ease(Ease.InQuad, 2.0) == 1.0)
}

@test fn tween_ping_pongs() {
    var t = Tween(0.0, 10.0, 4, Ease.Linear)
    var seen = List<float>()
    for i in 0..9 {
        seen.push(t.value())
        t.advance()
    }
    // Lists compare by identity (LANGUAGE.md 9.2): compare their text.
    assert("{seen}" == "[0.0, 2.5, 5.0, 7.5, 10.0, 7.5, 5.0, 2.5, 0.0]", "{seen}")
}
