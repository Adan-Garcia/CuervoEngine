// The game's own tests (`cuervo-tools test examples/garden`): its helpers
// next to the packages' names they share.

import tween

@test fn the_games_petal_is_not_the_palettes() {
    assert(petal(0) == 5)
    assert(petal(4) == 6)
}

@test fn mix_clamps() {
    assert(mix(0.0, 10.0, 0.5) == 5.0)
    assert(mix(0.0, 10.0, 2.0) == 10.0)
}

@test fn blooms_use_the_package_tween() {
    var t = tween.Tween(12.0, 48.0, 60, tween.Ease.Linear)
    assert(t.value() == 12.0)
}
