// Multi-scene physics showcase for Cuervo's 2D Box2D integration:
//   [1] Platformer: CharacterBody2D (move_and_slide), StaticBody2D, RigidBody2D Crate, Area2D Coin, RayCast2D
//   [2] Joints: PinJoint2D Bridge, DistanceJoint2D Pendulum, DampedSpringJoint2D Trampoline,
//               PrismaticJoint2D Elevator, WeldJoint2D Cross, PogoJoint2D Hopper, MotorJoint2D, FilterJoint2D
//   [3] Vehicles: WheelJoint2D Buggy with Suspension & Motor, Towed Trailer, Chain Terrain
//   [4] Sandbox: AnimatableBody2D Moving Platforms, CollisionPolygon2D Hulls, ShapeCast2D Scanner,
//                CCD Bullet, Physics2D.explode & Physics2D.intersect_point

var coins_collected = 0
var crates_pushed = 0
var explosions_count = 0

// Pushable rigid body crate.
class Crate extends RigidBody2D {
    fn ready() {
        lock_rotation = true
        _Physics.body_set_motion_locks(body_handle, true)
    }

    fn draw(g: Canvas) {
        var p = global_position()
        var sz = vec2(36.0, 36.0)
        if find("Shape") is CollisionShape2D s {
            sz = s.size
        }
        var hs = sz * 0.5
        g.rect(p - hs, sz,
               fill = Color { r = 0.85, g = 0.55, b = 0.2, a = 1.0 },
               stroke = Color { r = 0.45, g = 0.28, b = 0.08, a = 1.0 }, width = 2.0,
               rotation = rotation)
        var inset = hs - vec2(2.0, 2.0)
        g.line(p - inset.rotated(rotation), p + inset.rotated(rotation),
               color = Color { r = 0.45, g = 0.28, b = 0.08, a = 1.0 }, width = 1.5)
        var diag2 = vec2(inset.x, -inset.y)
        g.line(p - diag2.rotated(rotation), p + diag2.rotated(rotation),
               color = Color { r = 0.45, g = 0.28, b = 0.08, a = 1.0 }, width = 1.5)
    }
}

// Collectible coin sensor area.
class Coin extends Area2D {
    var collected = false

    fn ready() {
        super.ready()
        body_entered.connect(fn(body: Node2D) {
            if !collected && body is Player {
                collected = true
                coins_collected = coins_collected + 1
                queue_free()
            }
        })
    }

    fn draw(g: Canvas) {
        if !collected {
            var p = global_position()
            g.circle(p, 14.0,
                     fill = Color { r = 1.0, g = 0.85, b = 0.1, a = 1.0 },
                     stroke = Color { r = 0.85, g = 0.6, b = 0.0, a = 1.0 }, width = 2.5)
            g.circle(p, 7.0,
                     fill = Color { r = 1.0, g = 0.95, b = 0.5, a = 1.0 })
        }
    }
}

// Controllable character body using move_and_slide.
class Player extends CharacterBody2D {
    var speed = 300.0
    var jump_velocity = -575.0
    var gravity = 980.0
    var facing = 1.0

    fn update(dt: float) {
        if !is_on_floor() {
            velocity.y = velocity.y + gravity * dt
        }

        if Input.pressed(#jump) && is_on_floor() {
            velocity.y = jump_velocity
        }

        var dir = 0.0
        if Input.held(#move_right) {
            dir = dir + 1.0
        }
        if Input.held(#move_left) {
            dir = dir - 1.0
        }

        if dir != 0.0 {
            velocity.x = dir * speed
            facing = dir
        } else {
            velocity.x = 0.0
        }

        move_and_slide()
    }

    fn draw(g: Canvas) {
        var p = global_position()
        g.rect(p - vec2(16.0, 28.0), vec2(32.0, 56.0),
               fill = Color { r = 0.2, g = 0.7, b = 1.0, a = 1.0 },
               stroke = Color { r = 0.9, g = 0.95, b = 1.0, a = 1.0 }, width = 2.0)
        var eye_x = p.x + facing * 6.0
        g.circle(vec2(eye_x, p.y - 12.0), 3.5,
                 fill = Color { r = 0.05, g = 0.08, b = 0.12, a = 1.0 })
    }
}

// Bridge plank visual node for Scene 2.
class BridgePlank extends RigidBody2D {
    fn draw(g: Canvas) {
        var p = global_position()
        var sz = vec2(58.0, 12.0)
        if find("Shape") is CollisionShape2D s {
            sz = s.size
        }
        g.rect(p - sz * 0.5, sz,
               fill = Color { r = 0.65, g = 0.42, b = 0.2, a = 1.0 },
               stroke = Color { r = 0.38, g = 0.22, b = 0.08, a = 1.0 }, width = 1.5,
               rotation = rotation)
    }
}

// Wrecking ball pendulum in Scene 2.
class PendulumBall extends RigidBody2D {
    fn draw(g: Canvas) {
        var p = global_position()
        g.line(vec2(680.0, 100.0), p,
               color = Color { r = 0.6, g = 0.65, b = 0.75, a = 0.9 }, width = 3.0)
        g.circle(p, 24.0,
                 fill = Color { r = 0.45, g = 0.5, b = 0.6, a = 1.0 },
                 stroke = Color { r = 0.75, g = 0.8, b = 0.9, a = 1.0 }, width = 2.0)
        var hl = p + vec2(-6.0, -6.0).rotated(rotation)
        g.circle(hl, 5.0,
                 fill = Color { r = 0.85, g = 0.9, b = 0.95, a = 0.6 })
    }
}

// Trampoline pad on a damped spring + vertical guide in Scene 2.
class TrampolinePad extends RigidBody2D {
    var base_x = 880.0
    var base_y = 650.0
    var timer = 0.0

    fn ready() {
        base_x = position.x
    }

    fn update(dt: float) {
        timer += dt
        if abs(position.x - base_x) > 0.5 {
            position.x = base_x
            _Physics.body_set_transform(body_handle, global_position(), 0.0)
        }
    }

    fn draw(g: Canvas) {
        var p = global_position()
        // Draw spring coils between SpringBase (base_x, 650) and pad
        var top_y = p.y + 8.0
        var bot_y = base_y - 10.0
        if bot_y > top_y {
            var mid_y = (top_y + bot_y) * 0.5
            g.line(vec2(base_x - 20.0, bot_y), vec2(base_x + 20.0, mid_y),
                   color = Color { r = 0.7, g = 0.8, b = 0.9, a = 0.85 }, width = 2.5)
            g.line(vec2(base_x + 20.0, mid_y), vec2(base_x - 20.0, top_y),
                   color = Color { r = 0.7, g = 0.8, b = 0.9, a = 0.85 }, width = 2.5)
        }
        g.rect(vec2(base_x - 50.0, base_y - 10.0), vec2(100.0, 20.0),
               fill = Color { r = 0.35, g = 0.4, b = 0.5, a = 1.0 },
               stroke = Color { r = 0.9, g = 0.8, b = 0.2, a = 1.0 }, width = 2.0)
        g.rect(p - vec2(45.0, 8.0), vec2(90.0, 16.0),
               fill = Color { r = 0.2, g = 0.85, b = 0.45, a = 1.0 },
               stroke = Color { r = 0.9, g = 1.0, b = 0.9, a = 1.0 }, width = 2.0,
               rotation = rotation)
    }
}

// Motorized elevator platform in Scene 2.
class ElevatorCar extends RigidBody2D {
    var timer = 0.0
    var direction = -1.0
    var joint: PrismaticJoint2D? = null

    fn ready() {
        if parent != null && parent.find("ElevatorJoint") is PrismaticJoint2D j {
            joint = j
        }
    }

    fn update(dt: float) {
        timer = timer + dt
        if position.y <= 314.0 && direction < 0.0 {
            direction = 1.0
            timer = 0.0
        } else if position.y >= 526.0 && direction > 0.0 {
            direction = -1.0
            timer = 0.0
        } else if timer > 3.0 {
            direction = -direction
            timer = 0.0
        }
        if joint != null {
            var spd = 80.0
            if direction < 0.0 {
                spd = -80.0
            }
            joint.set_motor_speed(spd)
            joint.set_motor_enabled(true)
        }
    }

    fn draw(g: Canvas) {
        var p = global_position()
        g.rect(p - vec2(45.0, 9.0), vec2(90.0, 18.0),
               fill = Color { r = 0.3, g = 0.6, b = 0.95, a = 1.0 },
               stroke = Color { r = 0.85, g = 0.92, b = 1.0, a = 1.0 }, width = 2.0,
               rotation = rotation)
    }
}

// Welded cross bar in Scene 2.
class WeldedCross extends RigidBody2D {
    fn draw(g: Canvas) {
        var p = global_position()
        var sz = vec2(60.0, 14.0)
        if name == "WeldV" {
            sz = vec2(14.0, 60.0)
        }
        g.rect(p - sz * 0.5, sz,
               fill = Color { r = 0.85, g = 0.35, b = 0.35, a = 1.0 },
               stroke = Color { r = 1.0, g = 0.75, b = 0.75, a = 1.0 }, width = 1.5,
               rotation = rotation)
    }
}

// Pogo stick body in Scene 2.
class PogoBody extends RigidBody2D {
    var base_x = 540.0
    var hop_timer = 0.0

    fn ready() {
        base_x = position.x
    }

    fn update(dt: float) {
        hop_timer += dt
        if abs(position.x - base_x) > 0.5 {
            position.x = base_x
            _Physics.body_set_transform(body_handle, global_position(), 0.0)
        }
        if hop_timer > 1.6 {
            hop_timer = 0.0
            set_linear_velocity(vec2(0.0, -320.0))
        }
    }

    fn draw(g: Canvas) {
        var p = global_position()
        if parent != null && parent.find("PogoLeg") is Node2D leg {
            g.line(p, leg.global_position(),
                   color = Color { r = 0.95, g = 0.85, b = 0.3, a = 0.9 }, width = 3.0)
        }
        g.circle(p, 18.0,
                 fill = Color { r = 0.9, g = 0.5, b = 0.15, a = 1.0 },
                 stroke = Color { r = 1.0, g = 0.85, b = 0.6, a = 1.0 }, width = 2.0)
    }
}

class PogoLeg extends RigidBody2D {
    var base_x = 540.0

    fn ready() {
        base_x = position.x
    }

    fn update(dt: float) {
        if abs(position.x - base_x) > 0.5 {
            position.x = base_x
            _Physics.body_set_transform(body_handle, global_position(), 0.0)
        }
