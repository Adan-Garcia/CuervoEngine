    fn draw(g: Canvas) {
        var p = global_position()
        g.rect(p - vec2(5.0, 16.0), vec2(10.0, 32.0),
               fill = Color { r = 0.5, g = 0.55, b = 0.6, a = 1.0 },
               stroke = Color { r = 0.8, g = 0.85, b = 0.9, a = 1.0 }, width = 1.5,
               rotation = rotation)
    }
}

// MotorJoint2D target follower in Scene 2.
class MotorRotor extends RigidBody2D {
    var joint: MotorJoint2D? = null

    fn ready() {
        if parent != null && parent.find("MotorJoint") is MotorJoint2D j {
            joint = j
            joint.set_motor_speed(2.5)
        }
    }

    fn update(dt: float) {
        if joint != null {
            joint.set_motor_speed(2.5)
        }
    }

    fn draw(g: Canvas) {
        var p = global_position()
        g.rect(p - vec2(35.0, 8.0), vec2(70.0, 16.0),
               fill = Color { r = 0.65, g = 0.3, b = 0.85, a = 1.0 },
               stroke = Color { r = 0.9, g = 0.75, b = 1.0, a = 1.0 }, width = 2.0,
               rotation = rotation)
        g.circle(p, 5.0, fill = Color { r = 0.95, g = 0.9, b = 1.0, a = 1.0 })
    }
}

// FilterJoint2D overlapping bodies in Scene 2.
class FilterGhost extends RigidBody2D {
    var timer = 0.0
    var phase = 0.0

    fn ready() {
        if name == "GhostB" {
            phase = 3.14159
        }
    }

    fn update(dt: float) {
        timer += dt
        set_linear_velocity(vec2(cos(timer * 2.2 + phase) * 75.0, get_linear_velocity().y))
    }

    fn draw(g: Canvas) {
        var p = global_position()
        var col = Color { r = 0.3, g = 0.85, b = 0.85, a = 0.65 }
        if name == "GhostB" {
            col = Color { r = 0.95, g = 0.45, b = 0.75, a = 0.65 }
        }
        g.rect(p - vec2(17.0, 17.0), vec2(34.0, 34.0),
               fill = col,
               stroke = Color { r = 0.85, g = 1.0, b = 1.0, a = 0.9 }, width = 1.5,
               rotation = rotation)
    }
}

// Vehicle chassis in Scene 3.
class ChassisBody extends RigidBody2D {
    fn draw(g: Canvas) {
        var p = global_position()
        // Main body
        g.rect(p - vec2(55.0, 13.0), vec2(110.0, 26.0),
               fill = Color { r = 0.2, g = 0.7, b = 0.35, a = 1.0 },
               stroke = Color { r = 0.9, g = 0.95, b = 0.9, a = 1.0 }, width = 2.0,
               rotation = rotation)
        // Cabin rotated around chassis center
        var cab_center = p + vec2(7.5, -19.0).rotated(rotation)
        g.rect(cab_center - vec2(22.5, 9.0), vec2(45.0, 18.0),
               fill = Color { r = 0.3, g = 0.85, b = 0.95, a = 0.75 },
               stroke = Color { r = 0.9, g = 0.95, b = 0.9, a = 1.5 }, width = 1.5,
               rotation = rotation)
    }
}

// Vehicle wheel in Scene 3.
class WheelBody extends RigidBody2D {
    var wheel_radius = 18.0

    fn ready() {
        if find("Shape") is CollisionShape2D s {
            wheel_radius = s.radius
        }
    }

    fn draw(g: Canvas) {
        var p = global_position()
        g.circle(p, wheel_radius,
                 fill = Color { r = 0.2, g = 0.22, b = 0.25, a = 1.0 },
                 stroke = Color { r = 0.75, g = 0.8, b = 0.85, a = 1.0 }, width = 2.5)
        g.circle(p, 6.0, fill = Color { r = 0.6, g = 0.65, b = 0.7, a = 1.0 })
        var spoke = vec2(cos(rotation), sin(rotation)) * (wheel_radius - 2.0)
        g.line(p - spoke, p + spoke,
               color = Color { r = 0.85, g = 0.9, b = 0.95, a = 0.9 }, width = 2.0)
    }
}

// Towed trailer in Scene 3.
class TrailerBody extends RigidBody2D {
    fn draw(g: Canvas) {
        var p = global_position()
        if parent != null && parent.find("Chassis") is Node2D ch {
            var hitch_a = ch.global_position() + vec2(-55.0, 2.0).rotated(ch.global_rotation())
            var hitch_b = p + vec2(35.0, 0.0).rotated(rotation)
            g.line(hitch_a, hitch_b,
                   color = Color { r = 0.7, g = 0.75, b = 0.8, a = 0.9 }, width = 3.0)
        }
        g.rect(p - vec2(35.0, 8.0), vec2(70.0, 16.0),
               fill = Color { r = 0.55, g = 0.4, b = 0.25, a = 1.0 },
               stroke = Color { r = 0.85, g = 0.7, b = 0.5, a = 1.0 }, width = 2.0,
               rotation = rotation)
    }
}

// Boost zone sensor in Scene 3.
class BoostPad extends Area2D {
    var active_flash = 0.0

    fn ready() {
        super.ready()
        body_entered.connect(fn(body: Node2D) {
            if body is ChassisBody cb {
                cb.apply_impulse(vec2(6500.0, -1500.0))
                active_flash = 0.5
            }
        })
    }

    fn update(dt: float) {
        if active_flash > 0.0 {
            active_flash = active_flash - dt
        }
    }

    fn draw(g: Canvas) {
        var p = global_position()
        var col = Color { r = 0.2, g = 0.9, b = 0.5, a = 0.35 }
        if active_flash > 0.0 {
            col = Color { r = 1.0, g = 0.9, b = 0.2, a = 0.65 }
        }
        g.rect(p - vec2(45.0, 25.0), vec2(90.0, 50.0),
               fill = col,
               stroke = Color { r = 0.3, g = 1.0, b = 0.6, a = 0.85 }, width = 2.0)
        g.text(p - vec2(26.0, 7.0), "BOOST >>", 14.0,
               color = Color { r = 0.9, g = 1.0, b = 0.9, a = 0.95 })
    }
}

// Animatable horizontal moving platform in Scene 4.
class MovingPlatformH extends AnimatableBody2D {
