// Engine API, part 5: game UI (DESIGN.md 4.10). Retained UI nodes in the
// scene tree, drawn with the Canvas (SDF rounded rects + MSDF text).
//
// Layout. A Control's rect (`position` = top-left, `size`) is computed every
// tick before the UI updates: a Control whose parent isn't a Control is a UI
// root and is placed in the screen rect; every other Control is placed by
// its parent. Outside containers a control uses anchors + offsets
// (Godot-style): its edges sit at `parent.position + parent.size * anchor` +
// `offset`, and it never gets smaller than its combined minimum size (its
// content's, e.g. a label's text, and `min_size`). When a dimension's two
// anchors coincide the control grows around that anchor (0 = right/down,
// 0.5 = both ways, 1 = left/up); otherwise it grows right/down.
// Containers (VBox, HBox, Margin, Panel, Center) ignore their children's
// anchors and place them. All of it is plain float math in fixed tree order,
// so layout is deterministic (DESIGN.md 4.1).
//
// Focus. One control has the focus (`UI.focused`). The actions ui_up,
// ui_down, ui_left, ui_right (with key repeat), ui_accept and ui_cancel
// move it geometrically between the focusable controls of the UI root that
// holds it (wrapping around at the ends), activate it, or emit the root's
// `cancelled` signal. The pointer (`Input.pointer()`, ui_click) focuses what
// it moves over and activates what it clicks; sliders follow drags. Each
// input is consumed by the first root that uses it in a tick. Projects bind
// the ui_* actions in project.toml.
//
// Themes are minimal: colors, font sizes, padding (Theme). A control uses
// the nearest `theme` up its parents, else UI.theme.

// Colors, font sizes and spacing of the UI widgets. Assign one to a
// control's `theme` (or change UI.theme) to restyle a tree.
class Theme {
    // Text sizes: widgets and Label #normal; Label #title; Label #small.
    var font_size = 22.0
    // Font size of Label #title.
    var title_size = 52.0
    // Font size of Label #small.
    var small_size = 16.0
    // Text colors. Labels: #dim and #small use `text_dim`, #title and #accent
    // `accent`, #danger `danger`, #gold `gold`; widgets use `accent` when focused.
    var text = Color.hex("e8ecff")
    // Color of dim and small labels.
    var text_dim = Color.hex("8890b0")
    // Color of the text of a disabled widget.
    var text_disabled = Color.hex("4c5370")
    // Highlight color: focused widgets, title and accent labels.
    var accent = Color.hex("7fe6ff")
    // Color of Label #danger.
    var danger = Color.hex("ff5a8a")
    // Color of Label #gold.
    var gold = Color.hex("ffd866")
    // Panel background and border; button fills by state.
    var panel = Color.hex("0d1124f6")
    // Border color of panels.
    var panel_border = Color.hex("2c3560")
    // Fill of a button, toggle or slider at rest.
    var button = Color.hex("161c38")
    // Fill of a focused widget.
    var button_focus = Color.hex("22305e")
    // Fill of a widget while pressed.
    var button_pressed = Color.hex("3a4c90")
    var padding = vec2(20.0, 10.0) // inside buttons, toggles and sliders
    // Inside a Panel, on every side.
    var panel_padding = 28.0
    // Between VBox/HBox children.
    var separation = 12.0
    // Corner radius and border width of panels and widgets.
    var radius = 8.0
    // Border width in pixels of panels and widgets.
    var border = 2.0
}

// The base of every UI node: a laid-out rect, focus and input (see the
// top of this file).
class Control extends Node2D {
    // Anchors: fractions of the parent's rect (0,0 top-left .. 1,1
    // bottom-right) where the top-left and bottom-right edges sit. Offsets:
    // pixels added to them. set_anchors() sets all four from a preset.
    @export var anchor_min = vec2(0.0, 0.0)
    // Anchor of the bottom-right edge (see `anchor_min`).
    @export var anchor_max = vec2(0.0, 0.0)
    // Pixels added to the top-left edge after anchoring.
    @export var offset_min = vec2(0.0, 0.0)
    // Pixels added to the bottom-right edge after anchoring.
    @export var offset_max = vec2(0.0, 0.0)
    // The control is never smaller than this (or its content).
    @export var min_size = vec2(0.0, 0.0)
    // In an HBox/VBox: share the space left over by the other children.
    @export var expand = false
    // Buttons, toggles and sliders ignore input and use `text_disabled`.
    @export var disabled = false
    // The laid-out size (with `position`, the rect), set by layout every tick.
    var size = vec2(0.0, 0.0)
    // null: the nearest ancestor's theme, else UI.theme.
    var theme: Theme
    // Shown in a small box next to the control after it has had the focus
    // for a few ticks (keyboard, gamepad or pointer hover). "" shows nothing.
    @export var tooltip = ""

    // On a UI root: ui_cancel was pressed while it held the focus.
    signal cancelled

    // Controls are laid out in screen coordinates: they never inherit a
    // parent's transform (DESIGN.md 4.17, milestone 9.1).
    fn inherits_transform() -> bool {
        return false
    }

    // ---- overridable behavior
    // The size the content needs (a label's text); override in custom controls.
    fn content_min_size() -> vec2 {
        return vec2(0.0, 0.0)
    }
    // True if the control takes the focus (buttons, toggles and sliders do).
    fn can_focus() -> bool {
        return false
    }
    // ui_accept or a click while focused.
    fn activate() {}
    // A direction while focused; true if the control used it (sliders).
    fn nudge(dir: vec2) -> bool {
        return false
    }
    // A click (ui_click) at `p`; activates by default.
    fn pointer_down(p: vec2) {
        activate()
    }
    // The pointer moved to `p` while held after a click on this control.
    fn pointer_drag(p: vec2) {}

    // Controls that float (popups) aren't laid out by their parent and take
    // input as roots of their own.
    fn floating() -> bool {
        return false
    }
    // True when the parent's layout places it: visible and not floating.
    fn in_layout() -> bool {
        return visible && !floating()
    }
    // Containers that cut their children to their rect (scroll areas): the
    // pointer only reaches the children inside it.
    fn clips_children() -> bool {
        return false
    }
    // Text fields while being edited: UI routes the typed text to edit_tick().
    fn is_editing() -> bool {
        return false
    }
    // Called every tick while is_editing(); a text field applies the typed text and edit keys here.
    fn edit_tick() {}
    // ui_cancel while focused; true if the control used it (a text field
    // stops editing) so the root doesn't see the cancel.
    fn on_cancel() -> bool {
        return false
    }
    // UI roots only, once per tick before the pointer is handled (popups
    // close on a click outside).
    fn on_root_input() {}
    // The innermost scroll container under `p` that can scroll `dir`
    // (-1 up, 1 down, 0 any), or null.
    fn find_scroll(p: vec2, dir: float) -> Control {
        var found: Control
        if !visible {
            return found
        }
        if clips_children() && !contains(p) {
            return found
        }
        for c in children {
            if c is Control k && !k.floating() {
                var f = k.find_scroll(p, dir)
                if f != null {
                    found = f
                }
            }
        }
        return found
    }
    // The first scroll container of this subtree that can scroll `dir`
    // (-1 up, 1 down), wherever it is: what a gamepad stick scrolls when the
    // focus isn't inside one.
    fn find_any_scroll(dir: float) -> Control {
        if !visible {
            return null
        }
        for c in children {
            if c is Control k && !k.floating() {
                var f = k.find_any_scroll(dir)
                if f != null {
                    return f
                }
            }
        }
        return null
    }
    // Scroll containers: scroll by `amount` pixels; true if it moved.
    fn scroll_by(amount: vec2) -> bool {
        return false
    }
    // Scroll containers: pixels per wheel notch.
    fn scroll_step() -> float {
        return 0.0
    }

    // ---- queries
    // The larger of content_min_size() and `min_size`.
    fn combined_min_size() -> vec2 {
        return content_min_size().max(min_size)
    }
    // The middle of the control's rect.
    fn center() -> vec2 {
        return position + size * 0.5
    }
    // True if `p` is inside the control's rect.
    fn contains(p: vec2) -> bool {
        return p.x >= position.x && p.y >= position.y && p.x < position.x + size.x && p.y < position.y + size.y
    }
    // True if this control holds the focus.
    fn has_focus() -> bool {
        return UI.focused == self
    }
    // Gives this control the focus.
    fn grab_focus() {
        UI.focused = self
    }
    // True when its parent isn't a Control: it is laid out in the screen rect.
    fn is_ui_root() -> bool {
        return !(parent is Control)
    }
    // The theme in effect: `theme`, the nearest ancestor's, or UI.theme.
    fn get_theme() -> Theme {
        var n: Node = self
        while n != null {
            if n is Control c && c.theme != null {
                return c.theme
            }
            n = n.parent
        }
        return UI.theme
    }
    // False when it or an ancestor (Node2D or CanvasLayer) is hidden.
    fn is_visible_in_tree() -> bool {
        var n: Node = self
        while n != null {
            if n is Node2D d && !d.visible {
                return false
            }
            if n is CanvasLayer l && !l.visible {
                return false
            }
            n = n.parent
        }
        return true
    }
    // True if this control is `c` or above it in the tree.
    fn is_ancestor_of(c: Node) -> bool {
        var n = c
        while n != null {
            if n == self {
                return true
            }
            n = n.parent
        }
        return false
    }

    // Anchor presets: #full (with `margin` on every side), #center, #top,
    // #bottom, #left, #right, #top_left, #top_right, #bottom_left,
    // #bottom_right (`margin` away from the edges).
    fn set_anchors(preset: name, margin = 0.0) {
        if preset == #full {
            anchor_min = vec2(0.0, 0.0)
            anchor_max = vec2(1.0, 1.0)
            offset_min = vec2(margin, margin)
            offset_max = vec2(-margin, -margin)
            return
        }
        var a = vec2(0.5, 0.5)
        match preset {
            #top => a = vec2(0.5, 0.0)
            #bottom => a = vec2(0.5, 1.0)
            #left => a = vec2(0.0, 0.5)
            #right => a = vec2(1.0, 0.5)
            #top_left => a = vec2(0.0, 0.0)
            #top_right => a = vec2(1.0, 0.0)
            #bottom_left => a = vec2(0.0, 1.0)
            #bottom_right => a = vec2(1.0, 1.0)
            _ => a = vec2(0.5, 0.5)
        }
        anchor_min = a
        anchor_max = a
        offset_min = (vec2(0.5, 0.5) - a) * (2.0 * margin)
        offset_max = offset_min
    }

    // ---- layout
    // Layout internals: places the control in its parent's rect from its
    // anchors and offsets; containers override layout_children().
    fn layout_in(parent_pos: vec2, parent_size: vec2) {
        var lo = parent_pos + parent_size * anchor_min + offset_min
        var hi = parent_pos + parent_size * anchor_max + offset_max
        var sz = (hi - lo).max(combined_min_size())
        var extra = sz - (hi - lo)
        var gx = anchor_min.x == anchor_max.x ? anchor_min.x : 0.0
        var gy = anchor_min.y == anchor_max.y ? anchor_min.y : 0.0
        set_rect(lo - extra * vec2(gx, gy), sz)
    }
    // Places the control at `pos` with size `sz`, then lays out its children.
    fn set_rect(pos: vec2, sz: vec2) {
        position = pos
        size = sz
        layout_children()
    }
    // Lays out the Control children in this rect; containers override it to arrange them.
    fn layout_children() {
        for c in children {
            if c is Control k && !k.floating() {
                k.layout_in(position, size)
            }
        }
    }

    // Queues the tooltip of a control that has had the focus a while.
    fn draw_tree(g: Canvas) {
        super.draw_tree(g)
        if visible && tooltip != "" && has_focus() && UI.x.focus_ticks >= UI.x.tooltip_delay {
            Scene.overlays.push(self)
        }
    }
    // Draws the tooltip on the overlay layer; UI internals call it after the tree has been drawn.
    fn draw_overlay(g: Canvas) {
        if tooltip == "" || !has_focus() {
            return
        }
        var t = get_theme()
        var m = UI.measure(tooltip, t.small_size)
        var sz = m + vec2(20.0, 12.0)
        var at = vec2(position.x + 12.0, position.y + size.y + 6.0)
        if at.y + sz.y > Screen.size.y {
            at.y = position.y - sz.y - 6.0
        }
        at = at.min(Screen.size - sz).max(vec2(0.0, 0.0))
        g.rect(at, sz, fill = t.panel, stroke = t.accent, width = 1.0, radius = t.radius * 0.6)
        g.text(at + vec2(10.0, 6.0), tooltip, size = t.small_size, color = t.text)
    }

    // ---- focus helpers
    // Appends the visible focusable controls in this subtree to `out`, in tree order.
    fn collect_focusable(out: List<Control>) {
        if !visible {
            return
        }
        if can_focus() {
            out.push(self)
        }
        for c in children {
            if c is Control k && !k.floating() {
                k.collect_focusable(out)
            }
        }
    }
    // The topmost (last drawn) focusable control under `p`.
    fn focusable_at(p: vec2) -> Control {
        var found: Control
        if !visible {
            return found
        }
        if can_focus() && contains(p) {
            found = self
        }
        if clips_children() && !contains(p) {
            return found
        }
        for c in children {
            if c is Control k && !k.floating() {
                var f = k.focusable_at(p)
                if f != null {
                    found = f
                }
            }
        }
        return found
    }
    // The UI root this control belongs to (the nearest ancestor-or-self that
    // is a root), or null.
    fn root_control() -> Control {
        var n: Node = self
        while n != null {
            if n is Control c && c.is_ui_root() {
                return c
            }
            n = n.parent
        }
        return null
    }
    // Emits `cancelled` (used by the focus handling).
    fn emit_cancelled() {
        emit cancelled
    }

    // UI roots lay out their tree and handle input before it updates.
    fn update_tree(dt: float) {
        if !freed && is_ui_root() && can_process() && is_visible_in_tree() {
            layout_in(vec2(0.0, 0.0), Screen.size)
            UI.process(self)
        }
        super.update_tree(dt)
    }
}

// ---------------------------------------------------------------- containers

// A control that arranges its children; the base of VBox, HBox, Margin, Panel and Center.
class Container extends Control {}

// Stacks visible children (VBox: top to bottom, HBox: left to right) at
// their minimum size along the stack, filling the other direction. Space
// left over goes to `expand` children, else `align` places the stack.
class BoxContainer extends Container {
    @export var separation = -1.0 // < 0: the theme's
    @export var align = #begin    // #begin, #center, #end
    // True stacks top to bottom; HBox overrides it to stack left to right.
    fn vertical() -> bool {
        return true
    }
    // The space between children: `separation`, or the theme's when it is negative.
    fn gap() -> float {
        return separation >= 0.0 ? separation : get_theme().separation
    }
    // The stack's minimum size: children along the stack plus gaps, the widest across.
    fn content_min_size() -> vec2 {
        var along = 0.0
        var across = 0.0
        var n = 0
        for c in children {
            if c is Control k && k.in_layout() {
                var m = k.combined_min_size()
                along += vertical() ? m.y : m.x
                across = max(across, vertical() ? m.x : m.y)
                n += 1
            }
        }
        if n > 1 {
            along += gap() * ((n - 1) as float)
        }
        return vertical() ? vec2(across, along) : vec2(along, across)
    }
    // Stacks the visible children, shares leftover space among `expand` children and applies `align`.
    fn layout_children() {
        var need = content_min_size()
        var extra = max(vertical() ? size.y - need.y : size.x - need.x, 0.0)
        var expanders = 0
        for c in children {
            if c is Control k && k.in_layout() && k.expand {
                expanders += 1
            }
        }
        var cursor = 0.0
        if expanders == 0 {
            if align == #center {
                cursor = extra * 0.5
            } else if align == #end {
                cursor = extra
            }
        }
        var first = true
        for c in children {
            if c is Control k && k.in_layout() {
                if !first {
                    cursor += gap()
                }
                first = false
                var m = k.combined_min_size()
                var len = vertical() ? m.y : m.x
                if k.expand {
                    len += extra / (expanders as float)
                }
                if vertical() {
                    k.set_rect(position + vec2(0.0, cursor), vec2(size.x, len))
                } else {
                    k.set_rect(position + vec2(cursor, 0.0), vec2(len, size.y))
                }
                cursor += len
            }
        }
    }
}

// A BoxContainer that stacks children top to bottom.
class VBox extends BoxContainer {}

// A BoxContainer that stacks children left to right.
class HBox extends BoxContainer {
    // False: HBox stacks left to right.
    fn vertical() -> bool {
        return false
    }
}

// Children fill the rect minus `margins` (left, top, right, bottom).
class Margin extends Container {
    // Left, top, right and bottom, in pixels.
    @export var margins = vec4(0.0, 0.0, 0.0, 0.0)
    // The empty border around the children (`margins`).
    fn inset() -> vec4 {
        return margins
    }
    // The children's minimum size plus the inset.
    fn content_min_size() -> vec2 {
        var m = vec2(0.0, 0.0)
        for c in children {
            if c is Control k && k.in_layout() {
                m = m.max(k.combined_min_size())
            }
        }
        var i = inset()
        return m + vec2(i.x + i.z, i.y + i.w)
    }
    // Gives the children the rect minus the inset.
    fn layout_children() {
        var i = inset()
        for c in children {
            if c is Control k && !k.floating() {
                k.set_rect(position + vec2(i.x, i.y), (size - vec2(i.x + i.z, i.y + i.w)).max(vec2(0.0, 0.0)))
            }
        }
    }
}

// A Margin with a themed background; adds the theme's panel padding.
class Panel extends Margin {
    // The empty border around the children (the theme's panel padding).
    fn inset() -> vec4 {
        return margins + vec4(get_theme().panel_padding)
    }
    // Draws the panel's rounded background and border.
    fn draw(g: Canvas) {
        var t = get_theme()
        g.rect(position, size, fill = t.panel, stroke = t.panel_border, width = t.border, radius = t.radius * 1.5)
    }
}

// Children at their minimum size, centered.
class Center extends Container {
    // The largest child's minimum size.
    fn content_min_size() -> vec2 {
        var m = vec2(0.0, 0.0)
        for c in children {
            if c is Control k && k.in_layout() {
                m = m.max(k.combined_min_size())
            }
        }
        return m
    }
    // Centers each child at its minimum size.
    fn layout_children() {
        for c in children {
            if c is Control k && !k.floating() {
                var m = k.combined_min_size()
                k.set_rect(position + (size - m) * 0.5, m)
            }
        }
    }
}

// ---------------------------------------------------------------- widgets

// A line of text. `style` picks the size and color from the theme.
class Label extends Control {
    // The text shown.
    @export var text = ""
    @export var style = #normal // #normal, #title, #small, #dim, #accent, #danger, #gold
    @export var font_size = 0.0 // > 0 overrides the style's size
    @export var align = #left   // #left, #center, #right
    // The font size: `font_size` if set, else the style's size from the theme.
    fn text_size() -> float {
        if font_size > 0.0 {
            return font_size
        }
        var t = get_theme()
        if style == #title {
            return t.title_size
        }
        if style == #small {
            return t.small_size
        }
        return t.font_size
    }
    // The text color for `style`, from the theme.
    fn text_color() -> Color {
        var t = get_theme()
        match style {
            #dim | #small => return t.text_dim
            #accent | #title => return t.accent
            #danger => return t.danger
            #gold => return t.gold
            _ => return t.text
        }
    }
    // The size of the measured text.
    fn content_min_size() -> vec2 {
        return UI.measure(text, text_size())
    }
    // Draws the text, aligned within the rect.
    fn draw(g: Canvas) {
        var x = position.x
        if align == #center {
            x += size.x * 0.5
        } else if align == #right {
            x += size.x
        }
        g.text(vec2(x, position.y + size.y * 0.5), text, size = text_size(), color = text_color(), align = align,
               baseline = #middle)
    }
}

// A push button: ui_accept or a click while focused emits `pressed`.
class Button extends Control {
    // The caption.
    @export var text = ""
    // Activated: ui_accept while focused, or a click.
    signal pressed
    var flash = 0 // ticks of "pressed" highlight

    // Buttons take the focus unless disabled.
    fn can_focus() -> bool {
        return !disabled
    }
    // Emits `pressed` (nothing while disabled).
    fn activate() {
        if !disabled {
            flash = 8
            emit pressed
        }
    }
    // Counts down the brief pressed look after an activation.
    fn update(dt: float) {
        if flash > 0 {
            flash -= 1
        }
    }
    // The caption's size plus the theme padding.
    fn content_min_size() -> vec2 {
        var t = get_theme()
        return UI.measure(text, t.font_size) + t.padding * 2.0
    }
    // Draws the button fill by state, its border and the caption.
    fn draw(g: Canvas) {
        var t = get_theme()
        var focus = has_focus()
        var fill = flash > 0 ? t.button_pressed : (focus ? t.button_focus : t.button)
        g.rect(position, size, fill = fill, stroke = focus ? t.accent : t.panel_border, width = t.border,
               radius = t.radius)
        var color = disabled ? t.text_disabled : (focus ? t.accent : t.text)
        g.text(center(), text, size = t.font_size, color = color, align = #center, baseline = #middle)
    }
}

// An on/off switch with a label; ui_accept or a click flips it.
class Toggle extends Control {
    // The caption beside the check box.
    @export var text = ""
    // True when checked.
    @export var on = false
    // `on` changed; `value` is the new state.
    signal toggled(value: bool)

    // Toggles take the focus unless disabled.
    fn can_focus() -> bool {
        return !disabled
    }
    // Flips `on` and emits `toggled`.
    fn activate() {
        if !disabled {
            on = !on
            emit toggled(on)
        }
    }
    // The caption's size plus the box and theme padding.
    fn content_min_size() -> vec2 {
        var t = get_theme()
        return UI.measure(text, t.font_size) + t.padding * 2.0 + vec2(72.0, 0.0)
    }
    // Draws the toggle fill by state, the check box and the caption.
    fn draw(g: Canvas) {
        var t = get_theme()
        var focus = has_focus()
        g.rect(position, size, fill = focus ? t.button_focus : t.button, stroke = focus ? t.accent : t.panel_border,
               width = t.border, radius = t.radius)
        var color = disabled ? t.text_disabled : (focus ? t.accent : t.text)
        g.text(vec2(position.x + t.padding.x, position.y + size.y * 0.5), text, size = t.font_size, color = color,
               baseline = #middle)
        var sw = vec2(48.0, 24.0)
        var at = vec2(position.x + size.x - t.padding.x - sw.x, position.y + (size.y - sw.y) * 0.5)
        g.rect(at, sw, fill = on ? t.accent.with_alpha(0.35) : t.panel, stroke = on ? t.accent : t.text_dim, width = 2.0,
               radius = sw.y * 0.5)
        var knob = on ? at + vec2(sw.x - sw.y * 0.5, sw.y * 0.5) : at + vec2(sw.y * 0.5, sw.y * 0.5)
        g.circle(knob, sw.y * 0.5 - 4.0, fill = on ? t.accent : t.text_dim)
    }
}

// A value in [min_value, max_value] snapped to `increment`; ui_left/ui_right
// change it while focused, the pointer drags it.
class Slider extends Control {
    // The caption left of the track; empty for a bare track.
    @export var text = ""
    // The current value, between `min_value` and `max_value`.
    @export var value = 0.5
    // The lowest value.
    @export var min_value = 0.0
    // The highest value.
    @export var max_value = 1.0
    @export var increment = 0.1 // 0: continuous
    // `value` changed (keys or dragging).
    signal changed(value: float)

    // Sliders take the focus unless disabled.
    fn can_focus() -> bool {
        return !disabled
    }
    // Sets `value` clamped and snapped, emitting `changed` if it moved.
    fn set_value(v: float) {
        var x = clamp(v, min_value, max_value)
        if increment > 0.0 {
            x = clamp(min_value + round((x - min_value) / increment) * increment, min_value, max_value)
        }
        if x != value {
            value = x
            emit changed(x)
        }
    }
    // `value` as a fraction of the range, 0..1.
    fn ratio() -> float {
        if max_value <= min_value {
            return 0.0
        }
        return (value - min_value) / (max_value - min_value)
    }
    // ui_left and ui_right step the value by `increment`; true if it was used.
    fn nudge(dir: vec2) -> bool {
        if dir.x == 0.0 || disabled {
            return false
        }
        var s = increment > 0.0 ? increment : (max_value - min_value) * 0.05
        set_value(value + dir.x * s)
        return true
    }
    // The left end of the track in screen pixels.
    fn track_x() -> float {
        var t = get_theme()
        return text == "" ? position.x + t.padding.x : position.x + size.x * 0.42
    }
    // The track's length in pixels.
    fn track_width() -> float {
        var t = get_theme()
        return max(position.x + size.x - t.padding.x - 64.0 - track_x(), 1.0)
    }
    // A click sets the value from the pointer position.
    fn pointer_down(p: vec2) {
        pointer_drag(p)
    }
    // Dragging sets the value from the pointer position.
    fn pointer_drag(p: vec2) {
        if !disabled {
            set_value(min_value + clamp((p.x - track_x()) / track_width(), 0.0, 1.0) * (max_value - min_value))
        }
    }
    // The caption's size plus the track's minimum length.
    fn content_min_size() -> vec2 {
        var t = get_theme()
        return UI.measure(text, t.font_size) + t.padding * 2.0 + vec2(260.0, 0.0)
    }
    // Draws the fill by state, the caption, the track and the value.
    fn draw(g: Canvas) {
        var t = get_theme()
        var focus = has_focus()
        g.rect(position, size, fill = focus ? t.button_focus : t.button, stroke = focus ? t.accent : t.panel_border,
               width = t.border, radius = t.radius)
        var color = disabled ? t.text_disabled : (focus ? t.accent : t.text)
        var mid = position.y + size.y * 0.5
        if text != "" {
            g.text(vec2(position.x + t.padding.x, mid), text, size = t.font_size, color = color, baseline = #middle)
        }
        var x0 = track_x()
        var w = track_width()
        g.rect(vec2(x0, mid - 3.0), vec2(w, 6.0), fill = t.panel, radius = 3.0)
        g.rect(vec2(x0, mid - 3.0), vec2(w * ratio(), 6.0), fill = color, radius = 3.0)
        g.circle(vec2(x0 + w * ratio(), mid), 9.0, fill = color)
        var pct = round(ratio() * 100.0) as int
        g.text(vec2(position.x + size.x - t.padding.x, mid), "{pct}%", size = t.small_size, color = color, align = #right,
               baseline = #middle)
    }
}

// ---------------------------------------------------------------- layout containers (milestone 9.3)

// Children in a grid of `columns` columns, filled row by row. A column is as
// wide as its widest cell and a row as tall as its tallest; children fill
// their cell. Space left over goes equally to the columns (rows) that hold an
// `expand` child.
class GridContainer extends Container {
    // Cells per row.
    @export var columns = 2
    // Gap between columns / rows; < 0: the theme's separation.
    @export var h_separation = -1.0
    // Gap between rows (see h_separation).
    @export var v_separation = -1.0

    // The column gap in effect: h_separation, or the theme's separation if negative.
    fn hgap() -> float {
        return h_separation >= 0.0 ? h_separation : get_theme().separation
    }
    // The row gap in effect: v_separation, or the theme's separation if negative.
    fn vgap() -> float {
        return v_separation >= 0.0 ? v_separation : get_theme().separation
    }
    // The laid-out children, in order.
    fn cells() -> List<Control> {
        var out = List<Control>()
        for c in children {
            if c is Control k && k.in_layout() {
                out.push(k)
            }
        }
        return out
    }
    // Minimum column widths and row heights, and which of them grow.
    fn measure_grid(widths: List<float>, heights: List<float>, grow_x: List<bool>, grow_y: List<bool>) {
        var cols = max(columns, 1)
        var list = cells()
        var rows = (list.len() + cols - 1) / cols
        for i in 0..cols {
            widths.push(0.0)
            grow_x.push(false)
        }
        for i in 0..rows {
            heights.push(0.0)
            grow_y.push(false)
        }
        for i in 0..list.len() {
            var m = list[i].combined_min_size()
            var cx = i % cols
            var ry = i / cols
            widths[cx] = max(widths[cx], m.x)
            heights[ry] = max(heights[ry], m.y)
            if list[i].expand {
                grow_x[cx] = true
                grow_y[ry] = true
            }
        }
    }
    // Sum of the column widths and row heights plus the gaps.
    fn content_min_size() -> vec2 {
        var w = List<float>()
        var h = List<float>()
        var gx = List<bool>()
        var gy = List<bool>()
        measure_grid(w, h, gx, gy)
        var total = vec2(0.0, 0.0)
        for x in w {
            total.x += x
        }
        for y in h {
            total.y += y
        }
        if w.len() > 1 {
            total.x += hgap() * ((w.len() - 1) as float)
        }
        if h.len() > 1 {
            total.y += vgap() * ((h.len() - 1) as float)
        }
        return total
    }
    // Sizes the columns and rows (growing those holding an `expand` child) and places each child in its cell.
    fn layout_children() {
        var w = List<float>()
        var h = List<float>()
        var gx = List<bool>()
        var gy = List<bool>()
        measure_grid(w, h, gx, gy)
        var need = content_min_size()
        var extra = (size - need).max(vec2(0.0, 0.0))
        var nx = 0
        for g in gx {
            if g {
                nx += 1
            }
        }
        var ny = 0
        for g in gy {
            if g {
                ny += 1
            }
        }
        for i in 0..w.len() {
            if gx[i] {
                w[i] += extra.x / (nx as float)
            }
        }
        for i in 0..h.len() {
            if gy[i] {
                h[i] += extra.y / (ny as float)
            }
        }
        var cols = max(columns, 1)
        var list = cells()
        var xs = List<float>()
        var cursor = 0.0
        for i in 0..w.len() {
            xs.push(cursor)
            cursor += w[i] + hgap()
        }
        var ys = List<float>()
        cursor = 0.0
        for i in 0..h.len() {
            ys.push(cursor)
            cursor += h[i] + vgap()
        }
        for i in 0..list.len() {
            var cx = i % cols
            var ry = i / cols
            list[i].set_rect(position + vec2(xs[cx], ys[ry]), vec2(w[cx], h[ry]))
        }
    }
}

// Children placed left to right in rows that wrap when the next child would
// pass the right edge (`vertical`: top to bottom in columns that wrap at the
// bottom). Children keep their minimum size. Its minimum size follows the
// size it was last given (a wrapped height needs the width), so a flow inside
// a box settles one tick after its width changes.
class FlowContainer extends Container {
    // true: columns that fill downwards instead of rows.
    @export var vertical = false
    // Gaps along the flow and between lines; < 0: the theme's separation.
    @export var h_separation = -1.0
    // Gap between lines (see h_separation).
    @export var v_separation = -1.0

    // The gap along the flow in effect: h_separation, or the theme's separation if negative.
    fn hgap() -> float {
        return h_separation >= 0.0 ? h_separation : get_theme().separation
    }
    // The gap between lines in effect: v_separation, or the theme's separation if negative.
    fn vgap() -> float {
        return v_separation >= 0.0 ? v_separation : get_theme().separation
    }
    // Lays the children out within `limit` along the flow; places them when
    // `place`. Returns the used size.
    fn flow(limit: float, place: bool) -> vec2 {
        var along_gap = vertical ? vgap() : hgap()
        var line_gap = vertical ? hgap() : vgap()
        var a = 0.0     // cursor along the flow
        var line = 0.0  // start of the current line, across the flow
        var line_len = 0.0
        var used_along = 0.0
        var first = true
        for c in children {
            if c is Control k && k.in_layout() {
                var m = k.combined_min_size()
                var len = vertical ? m.y : m.x
                var thick = vertical ? m.x : m.y
                if !first && a + len > limit {
                    line += line_len + line_gap
                    a = 0.0
                    line_len = 0.0
                    first = true
                }
                if place {
                    k.set_rect(position + (vertical ? vec2(line, a) : vec2(a, line)), m)
                }
                a += len + along_gap
                used_along = max(used_along, a - along_gap)
                line_len = max(line_len, thick)
                first = false
            }
        }
        var across = line + line_len
        return vertical ? vec2(across, used_along) : vec2(used_along, across)
    }
    // The widest child's size; when it has a size, the extent along the flow is wrapped to it and the other axis grows to fit the lines.
    fn content_min_size() -> vec2 {
        var widest = vec2(0.0, 0.0)
        for c in children {
            if c is Control k && k.in_layout() {
                widest = widest.max(k.combined_min_size())
            }
        }
        var limit = vertical ? size.y : size.x
        if limit <= 0.0 {
            return widest
        }
        var used = flow(limit, false)
        return vertical ? vec2(used.x, widest.y) : vec2(widest.x, used.y)
    }
    // Places the children in wrapping lines within the container's size along the flow.
    fn layout_children() {
        flow(vertical ? size.y : size.x, true)
    }
}

// Two children side by side (`vertical`: one above the other) with a bar
// between them. The bar is focusable: ui_left/right (ui_up/down when
// vertical) move it, and the pointer drags it. Each child keeps at least its
// minimum size.
class SplitContainer extends Container {
    // true: the first child on top, the bar horizontal.
    @export var vertical = false
    // The first child's share of the space left after the bar, 0..1.
    @export var split = 0.5
    // The bar's thickness in pixels.
    @export var bar_size = 12.0
    // Pixels a ui_* press moves the bar.
    @export var handle_step = 24.0
    // `split` changed (keys or dragging).
    signal split_changed(value: float)

    // Focusable unless disabled, so the bar can be moved with the keys.
    fn can_focus() -> bool {
        return !disabled
    }
    // The first two laid-out children.
    fn pair() -> List<Control> {
        var out = List<Control>()
        for c in children {
            if c is Control k && k.in_layout() && out.len() < 2 {
                out.push(k)
            }
        }
        return out
    }
    // The component of `v` along the split direction (y when vertical, else x).
    fn along(v: vec2) -> float {
        return vertical ? v.y : v.x
    }
    // Space for the children along the split direction.
    fn available() -> float {
        return max(along(size) - bar_size, 1.0)
    }
    // The first child's length, within the children's minimum sizes.
    fn first_length() -> float {
        var p = pair()
        if p.len() < 2 {
            return available()
        }
        var lo = along(p[0].combined_min_size())
        var hi = available() - along(p[1].combined_min_size())
        return clamp(available() * split, lo, max(hi, lo))
    }
    // Sets `split` (clamped to 0..1), emitting `split_changed` when it changed.
    fn set_split(v: float) {
        var x = clamp(v, 0.0, 1.0)
        if x != split {
            split = x
            emit split_changed(x)
        }
    }
    // Top-left corner of the bar.
    fn bar_rect_pos() -> vec2 {
        var f = first_length()
        return vertical ? position + vec2(0.0, f) : position + vec2(f, 0.0)
    }
    // Size of the bar.
    fn bar_rect_size() -> vec2 {
        return vertical ? vec2(size.x, bar_size) : vec2(bar_size, size.y)
    }
    // Center of the bar.
    fn center() -> vec2 {
        return bar_rect_pos() + bar_rect_size() * 0.5
    }
    // The control to focus at `p`: the bar itself, or a focusable control inside the children.
    fn focusable_at(p: vec2) -> Control {
        var found: Control
        if !visible {
            return found
        }
        var bp = bar_rect_pos()
        var bs = bar_rect_size()
        if !disabled && p.x >= bp.x && p.y >= bp.y && p.x < bp.x + bs.x && p.y < bp.y + bs.y {
            found = self
        }
        for c in children {
            if c is Control k && !k.floating() {
                var f = k.focusable_at(p)
                if f != null {
                    found = f
                }
            }
        }
        return found
    }
    // Moves the bar by `handle_step` pixels per press along its direction; false if the direction doesn't apply.
    fn nudge(dir: vec2) -> bool {
        var d = vertical ? dir.y : dir.x
        if d == 0.0 || disabled {
            return false
        }
        set_split(split + d * handle_step / available())
        return true
    }
    // Starts dragging: moves the bar under the pointer.
    fn pointer_down(p: vec2) {
        pointer_drag(p)
    }
    // Moves the bar to follow the pointer.
    fn pointer_drag(p: vec2) {
        if !disabled {
            var origin = vertical ? position.y : position.x
            set_split((along(p) - origin - bar_size * 0.5) / available())
        }
    }
    // The bar plus the first two children's minimum sizes along the split, and the larger across.
    fn content_min_size() -> vec2 {
        var p = pair()
        var a = bar_size
        var across = 0.0
        for k in p {
            var m = k.combined_min_size()
            a += along(m)
            across = max(across, vertical ? m.x : m.y)
        }
        return vertical ? vec2(across, a) : vec2(a, across)
    }
    // Gives the first child the space before the bar and the second the rest; a lone child fills the container.
    fn layout_children() {
        var p = pair()
        if p.len() == 0 {
            return
        }
        var f = first_length()
        if p.len() == 1 {
            p[0].set_rect(position, size)
            return
        }
        if vertical {
            p[0].set_rect(position, vec2(size.x, f))
            p[1].set_rect(position + vec2(0.0, f + bar_size), vec2(size.x, max(size.y - f - bar_size, 0.0)))
        } else {
            p[0].set_rect(position, vec2(f, size.y))
            p[1].set_rect(position + vec2(f + bar_size, 0.0), vec2(max(size.x - f - bar_size, 0.0), size.y))
        }
    }
    // Draws the bar with a grip line, highlighted while focused.
    fn draw(g: Canvas) {
        var t = get_theme()
        var focus = has_focus()
        var bp = bar_rect_pos()
        var bs = bar_rect_size()
        g.rect(bp, bs, fill = focus ? t.button_focus : t.button, stroke = focus ? t.accent : t.panel_border,
               width = t.border, radius = t.radius * 0.5)
        var c = bp + bs * 0.5
        var grip = vertical ? vec2(22.0, 0.0) : vec2(0.0, 22.0)
        g.line(c - grip, c + grip, color = focus ? t.accent : t.text_dim, width = 3.0)
    }
}

// Fits its children into the largest rectangle of width : height = `ratio`
// that fits (#fit) or the smallest that covers the whole container (#cover,
// clipped), placed by `align` (0 = left/top, 1 = right/bottom).
class AspectRatioContainer extends Container {
    // Width divided by height.
    @export var ratio = 1.0
    // #fit or #cover.
    @export var stretch = #fit
    // Where the child sits in the spare space: (0, 0) top-left, (1, 1) bottom-right.
    @export var align = vec2(0.5, 0.5)

    // Only #cover clips, since the child then overflows the container.
    fn clips_children() -> bool {
        return stretch == #cover
    }
    // The largest minimum size among the children.
    fn content_min_size() -> vec2 {
        var m = vec2(0.0, 0.0)
        for c in children {
            if c is Control k && k.in_layout() {
                m = m.max(k.combined_min_size())
            }
        }
        return m
    }
    // The child rectangle's size for the current container size.
    fn child_size() -> vec2 {
        var r = max(ratio, 0.0001)
        var wide = size.x / max(size.y, 0.0001) > r
        if (stretch == #cover) == wide {
            return vec2(size.x, size.x / r)
        }
        return vec2(size.y * r, size.y)
    }
    // Gives every child the ratio-fitted rectangle, placed by `align`.
    fn layout_children() {
        var cs = child_size()
        var at = position + (size - cs) * align
        for c in children {
            if c is Control k && k.in_layout() {
                k.set_rect(at, cs)
            }
        }
    }
    // Draws the children; with #cover they are clipped to the container.
    fn draw_tree(g: Canvas) {
        if !visible {
            return
        }
        if stretch == #cover {
            draw(g)
            UI.push_clip(g, position, size)
            for c in children {
                c.draw_tree(g)
            }
            UI.pop_clip(g)
        } else {
            super.draw_tree(g)
        }
    }
}

// One child inside a view onto it: the child gets its minimum size or the
// view's, whichever is larger, and the content scrolls by the wheel and
// `ui_scroll_up/down` actions (over the container, or when the focus is
// inside it), by dragging the bar or empty content, and by keyboard/gamepad
// focus moves (the focused control is scrolled into view). Content outside
// the view is clipped and can't be clicked.
class ScrollContainer extends Container {
    // Which directions scroll. A direction that doesn't scroll gives the
    // content the view's size there (and the container its minimum size).
    @export var vertical = true
    // Scroll horizontally too (see vertical).
    @export var horizontal = false
    // Pixels per wheel notch / first scroll press (held presses go slower).
    @export var wheel_step = 56.0
    // Scroll the focused control into view when focus moves into the content.
    @export var follow_focus = true
    // Draw the scroll bars (10 px wide, over the right/bottom edge).
    @export var show_bars = true
    // The content's offset: how far it is scrolled, 0 .. max_scroll().
    @export var scroll = vec2(0.0, 0.0)
    // `scroll` changed.
    signal scrolled(offset: vec2)

    var _content = vec2(0.0, 0.0)  // laid-out content size
    var _view = vec2(0.0, 0.0)     // viewport size (minus bars)
    var _seen_focus: Control
    var _drag = 0                  // 0 none, 1 bar, 2 content
    var _drag_from = vec2(0.0, 0.0)
    var _drag_scroll = vec2(0.0, 0.0)
    var _bar_vertical = true

    // Always clips: the content outside the view is hidden.
    fn clips_children() -> bool {
        return true
    }
    // Width of a scroll bar in pixels.
    fn bar_width() -> float {
        return 10.0
    }
    // Pixels one scroll press moves; the wheel step.
    fn scroll_step() -> float {
        return wheel_step
    }
    // The content child: the first laid-out Control.
    fn content() -> Control {
        for c in children {
            if c is Control k && k.in_layout() {
                return k
            }
        }
        return null
    }
    // The content's minimum size across any direction that doesn't scroll, and nothing along the scrolling ones.
    fn content_min_size() -> vec2 {
        var c = content()
        if c == null {
            return vec2(0.0, 0.0)
        }
        var m = c.combined_min_size()
        return vec2(horizontal ? 0.0 : m.x, vertical ? 0.0 : m.y)
    }
    // The farthest `scroll` can go.
    fn max_scroll() -> vec2 {
        return (_content - _view).max(vec2(0.0, 0.0))
    }
    // True if vertical scrolling is on and the content is taller than the view.
    fn needs_vertical_bar() -> bool {
        return vertical && max_scroll().y > 0.0
    }
    // True if horizontal scrolling is on and the content is wider than the view.
    fn needs_horizontal_bar() -> bool {
        return horizontal && max_scroll().x > 0.0
    }
    // Sets `scroll` (clamped), emitting `scrolled` when it moved.
    fn set_scroll(v: vec2) {
        var s = v.min(max_scroll()).max(vec2(0.0, 0.0))
        if !vertical {
            s.y = 0.0
        }
        if !horizontal {
            s.x = 0.0
        }
        if s != scroll {
            scroll = s
            emit scrolled(s)
        }
    }
    // Scrolls by `amount` pixels; true if the offset changed.
    fn scroll_by(amount: vec2) -> bool {
        var before = scroll
        set_scroll(scroll + amount)
        return scroll != before
    }
    // The control to scroll for a wheel at `p` in direction `dir` (-1 up, 1 down): an inner scroller first, else self if it can move that way; null if none.
    fn find_scroll(p: vec2, dir: float) -> Control {
        if !visible || !contains(p) {
            return null
        }
        var inner = super.find_scroll(p, dir)
        if inner != null {
            return inner
        }
        if dir < 0.0 && scroll.y <= 0.0 {
            return null
        }
        if dir > 0.0 && scroll.y >= max_scroll().y {
            return null
        }
        return self
    }
    // The control to scroll for `dir` when the pointer position doesn't matter (focus scrolling): an inner scroller first, else self if it can move that way.
    fn find_any_scroll(dir: float) -> Control {
        if !visible {
            return null
        }
        var inner = super.find_any_scroll(dir)
        if inner != null {
            return inner
        }
        if (dir < 0.0 && scroll.y > 0.0) || (dir > 0.0 && scroll.y < max_scroll().y) {
            return self
        }
        return null
    }
    // Scrolls so the rectangle (relative to the content's top-left) is inside the view.
    fn reveal(rel_pos: vec2, rel_size: vec2) {
        var s = scroll
        if rel_pos.y < s.y {
            s.y = rel_pos.y
        } else if rel_pos.y + rel_size.y > s.y + _view.y {
            s.y = rel_pos.y + rel_size.y - _view.y
        }
        if rel_pos.x < s.x {
            s.x = rel_pos.x
        } else if rel_pos.x + rel_size.x > s.x + _view.x {
            s.x = rel_pos.x + rel_size.x - _view.x
        }
        set_scroll(s)
    }
    // Sizes the content (bars take space only when it overflows), scrolls a newly focused control into view, and places it offset by `scroll`.
    fn layout_children() {
        var c = content()
        if c == null {
            return
        }
        var need = c.combined_min_size()
        // Bars take their width only when the content overflows.
        var view = size
        var bw = bar_width()
        var tall = vertical && need.y > view.y
        if tall {
            view.x -= bw
        }
        if horizontal && need.x > view.x {
            view.y -= bw
            if !tall && vertical && need.y > view.y {
                view.x -= bw
            }
        }
        var cs = vec2(horizontal ? max(need.x, view.x) : view.x, vertical ? max(need.y, view.y) : view.y)
        _view = view.max(vec2(0.0, 0.0))
        _content = cs
        // The content still sits where the last layout put it: a newly
        // focused control's offset in it is what to scroll into view.
        if follow_focus && UI.focused != null && UI.focused != _seen_focus && c.is_ancestor_of(UI.focused) {
            var f = UI.focused
            reveal(f.position - c.position, f.size)
        }
        _seen_focus = UI.focused
        set_scroll(scroll)
        c.set_rect(position - scroll, cs)
    }
    // Starts a drag: on a scroll bar it jumps the thumb to the pointer, elsewhere it drags the content.
    fn pointer_down(p: vec2) {
        _drag_from = p
        _drag_scroll = scroll
        _drag = 2
        var bw = bar_width()
        if needs_vertical_bar() && p.x >= position.x + size.x - bw {
            _drag = 1
            _bar_vertical = true
        } else if needs_horizontal_bar() && p.y >= position.y + size.y - bw {
            _drag = 1
            _bar_vertical = false
        }
        if _drag == 1 {
            // Jump the thumb's center to the click, then follow the drag.
            var ms = max_scroll()
            if _bar_vertical {
                var track = max(_view.y - thumb_length(true), 1.0)
                set_scroll(vec2(scroll.x, (p.y - position.y - thumb_length(true) * 0.5) / track * ms.y))
            } else {
                var track = max(_view.x - thumb_length(false), 1.0)
                set_scroll(vec2((p.x - position.x - thumb_length(false) * 0.5) / track * ms.x, scroll.y))
            }
            _drag_from = p
            _drag_scroll = scroll
        }
    }
    // Continues the drag started in pointer_down(): moves the thumb or the content.
    fn pointer_drag(p: vec2) {
        if _drag == 2 {
            set_scroll(_drag_scroll - (p - _drag_from))
        } else if _drag == 1 {
            var ms = max_scroll()
            if _bar_vertical {
                var track = max(_view.y - thumb_length(true), 1.0)
                set_scroll(vec2(scroll.x, _drag_scroll.y + (p.y - _drag_from.y) / track * ms.y))
            } else {
                var track = max(_view.x - thumb_length(false), 1.0)
                set_scroll(vec2(_drag_scroll.x + (p.x - _drag_from.x) / track * ms.x, scroll.y))
            }
        }
    }
    // Length of the scroll bar thumb for the vertical (`vert`) or horizontal bar, proportional to the view and at least 28 px.
    fn thumb_length(vert: bool) -> float {
        var view = vert ? _view.y : _view.x
        var total = vert ? _content.y : _content.x
        return clamp(view * view / max(total, 1.0), 28.0, max(view, 28.0))
    }
    // Draws the container, then the children clipped to the view, then the scroll bars.
    fn draw_tree(g: Canvas) {
        if !visible {
            return
        }
        draw(g)
        UI.push_clip(g, position, size)
        for c in children {
            c.draw_tree(g)
        }
        UI.pop_clip(g)
        if show_bars {
            draw_bars(g)
        }
    }
    // Draws the scroll bars that are needed.
    fn draw_bars(g: Canvas) {
        var t = get_theme()
        var ms = max_scroll()
        var bw = bar_width()
        if needs_vertical_bar() {
            var len = thumb_length(true)
            var y = position.y + (_view.y - len) * (scroll.y / ms.y)
            g.rect(vec2(position.x + size.x - bw, position.y), vec2(bw, _view.y), fill = t.panel, radius = bw * 0.5)
            g.rect(vec2(position.x + size.x - bw + 1.0, y), vec2(bw - 2.0, len), fill = t.text_dim, radius = bw * 0.5)
        }
        if needs_horizontal_bar() {
            var len = thumb_length(false)
            var x = position.x + (_view.x - len) * (scroll.x / ms.x)
            g.rect(vec2(position.x, position.y + size.y - bw), vec2(_view.x, bw), fill = t.panel, radius = bw * 0.5)
            g.rect(vec2(x, position.y + size.y - bw + 1.0), vec2(len, bw - 2.0), fill = t.text_dim, radius = bw * 0.5)
        }
    }
}

// ---------------------------------------------------------------- more widgets (milestone 9.3)

// A vector image (SVG or .evec, like Sprite's `asset`) in a layout rect.
// Raster images come with the asset pipeline of milestone 11.2.
class Image extends Control {
    // The image file, relative to the project ("" draws nothing).
    @export var asset = ""
    // #keep: natural size at the top-left; #scale: fills the rect, ignoring
    // the proportions; #keep_aspect: as large as fits, centered; #cover: as
    // small as covers the rect, centered and clipped.
    @export var stretch = #keep_aspect
    // Multiplies the image's colors (alpha included).
    @export var tint = Color { r = 1.0, g = 1.0, b = 1.0, a = 1.0 }
    // Mirror the image horizontally.
    @export var flip_h = false
    // Mirror the image vertically.
    @export var flip_v = false
    // true: the natural size doesn't count towards the minimum size (so a
    // layout can shrink the image); `min_size` still does.
    @export var ignore_natural_size = false

    // The document size of `asset` ((0, 0) when it can't be read).
    fn natural_size() -> vec2 {
        return asset == "" ? vec2(0.0, 0.0) : UI.image_size(asset)
    }
    // The natural size, or nothing with `ignore_natural_size`.
    fn content_min_size() -> vec2 {
        return ignore_natural_size ? vec2(0.0, 0.0) : natural_size()
    }
    // Draws the image placed and scaled by `stretch`, flipped and tinted.
    fn draw(g: Canvas) {
        var nat = natural_size()
        if asset == "" || nat.x <= 0.0 || nat.y <= 0.0 || size.x <= 0.0 || size.y <= 0.0 {
            return
        }
        var s = vec2(1.0, 1.0)
        var at = position
        if stretch == #scale {
            s = size / nat
        } else if stretch == #keep_aspect || stretch == #cover {
            var k = stretch == #cover ? max(size.x / nat.x, size.y / nat.y) : min(size.x / nat.x, size.y / nat.y)
            s = vec2(k, k)
            at = position + (size - nat * k) * 0.5
        }
        var drawn = nat * s
        if flip_h {
            s.x = -s.x
            at.x += drawn.x
        }
        if flip_v {
            s.y = -s.y
            at.y += drawn.y
        }
        if stretch == #cover {
            UI.push_clip(g, position, size)
        }
        g.vector(asset, at, scale = s, centered = false, tint = tint)
        if stretch == #cover {
            UI.pop_clip(g)
        }
    }
}

// Godot's name for Image.
class TextureRect extends Image {}

// A value in [min_value, max_value] shown as a filled bar (not focusable).
class ProgressBar extends Control {
    // Optional label at the left of the bar.
    @export var text = ""
    // The current value.
    @export var value = 0.0
    // The value at which the bar is empty.
    @export var min_value = 0.0
    // The value at which the bar is full.
    @export var max_value = 1.0
    // Draw "NN%" at the right.
    @export var show_percentage = true
    // `value` changed.
    signal changed(value: float)

    // Sets `value`, clamped, emitting `changed` if it moved.
    fn set_value(v: float) {
        var x = clamp(v, min_value, max_value)
        if x != value {
            value = x
            emit changed(x)
        }
    }
    // 0..1.
    fn ratio() -> float {
        if max_value <= min_value {
            return 0.0
        }
        return clamp((value - min_value) / (max_value - min_value), 0.0, 1.0)
    }
    // The label size plus padding and at least 160 px wide.
    fn content_min_size() -> vec2 {
        var t = get_theme()
        return UI.measure(text, t.font_size) + t.padding * 2.0 + vec2(160.0, 0.0)
    }
    // Draws the track, the filled part, the label and the percentage.
    fn draw(g: Canvas) {
        var t = get_theme()
        g.rect(position, size, fill = t.button, stroke = t.panel_border, width = t.border, radius = t.radius)
        var mid = position.y + size.y * 0.5
        var inner = size - vec2(t.border * 4.0, t.border * 4.0)
        var r = ratio()
        if r > 0.0 {
            g.rect(position + vec2(t.border * 2.0, t.border * 2.0), vec2(max(inner.x * r, inner.y), inner.y),
                   fill = disabled ? t.text_disabled : t.accent.with_alpha(0.55), radius = max(t.radius - 2.0, 1.0))
        }
        if text != "" {
            g.text(vec2(position.x + t.padding.x, mid), text, size = t.font_size, color = t.text, baseline = #middle)
        }
        if show_percentage {
            var pct = round(r * 100.0) as int
            g.text(vec2(position.x + size.x - t.padding.x, mid), "{pct}%", size = t.small_size, color = t.text,
                   align = #right, baseline = #middle)
        }
    }
}

// A single-line text field. Focus it and press ui_accept (or click it) to
// edit; typed text comes from the input frame (Input.text, so it replays),
// ui_backspace / ui_delete / ui_home / ui_end and left/right edit and move
// the caret, ui_accept finishes (`text_submitted`) and ui_cancel stops
// editing. Up/down stop editing and move the focus. Bind the ui_* actions to
// keys that don't type characters (arrows, Enter, Escape): a character typed
// on the tick of a ui_* press cancels that press.
class LineEdit extends Control {
    // The text in the field.
    @export var text = ""
    // Shown dimmed while empty.
    @export var placeholder = ""
    // > 0: the most characters the field takes.
    @export var max_length = 0
    // Draw every character as "*" (the text itself is unchanged).
    @export var secret = false
    // false: focusable and selectable, but can't be edited.
    @export var editable = true
    // Typing, deleting or set_text() changed `text`.
    signal text_changed(value: str)
    // ui_accept while editing.
    signal text_submitted(value: str)

    // Whether the field is being edited (typed text and edit keys reach it).
    var editing = false
    // The caret, in characters (0 .. char count).
    var caret = 0

    // Focusable unless disabled.
    fn can_focus() -> bool {
        return !disabled
    }
    // Whether the field is being edited.
    fn is_editing() -> bool {
        return editing
    }
    // Number of characters (not bytes) in `text`.
    fn char_count() -> int {
        return text.char_count()
    }
    // Replaces the text (no `text_changed` unless it differs); the caret goes to the end.
    fn set_text(s: str) {
        var changed = s != text
        text = s
        caret = char_count()
        if changed {
            emit text_changed(text)
        }
    }
    // Moves the caret to character `i`, clamped to the text.
    fn set_caret(i: int) {
        caret = clamp(i, 0, char_count())
    }
    // Inserts typed text at the caret (respecting max_length).
    fn insert_text(s: str) {
        if !editable || s == "" {
            return
        }
        var cs = text.chars()
        var add = s.chars()
        if max_length > 0 && cs.len() + add.len() > max_length {
            add = add.slice(0, max(max_length - cs.len(), 0))
        }
        if add.len() == 0 {
            return
        }
        var out = "".join(cs.slice(0, caret)) + "".join(add) + "".join(cs.slice(caret))
        caret += add.len()
        text = out
        emit text_changed(text)
    }
    // Removes characters `from` up to (not including) `to`, puts the caret at `from` and emits `text_changed`.
    fn delete_range(from: int, to: int) {
        var cs = text.chars()
        text = "".join(cs.slice(0, from)) + "".join(cs.slice(to))
        caret = from
        emit text_changed(text)
    }
    // Deletes the character before the caret.
    fn backspace() {
        if editable && caret > 0 {
            delete_range(caret - 1, caret)
        }
    }
    // Deletes the character after the caret.
    fn delete_forward() {
        if editable && caret < char_count() {
            delete_range(caret, caret + 1)
        }
    }
    // What UI routes to the field every tick while it is being edited.
    fn edit_tick() {
        if UI.typed_text != "" {
            insert_text(UI.typed_text)
        }
        if UI.x.backspace_pressed {
            backspace()
        }
        if UI.x.delete_pressed {
            delete_forward()
        }
        if UI.x.home_pressed {
            caret = 0
        }
        if UI.x.end_pressed {
            caret = char_count()
        }
    }
    // Starts editing; while editing, finishes it and emits `text_submitted`. Does nothing if not editable.
    fn activate() {
        if !editable {
            return
        }
        if editing {
            editing = false
            emit text_submitted(text)
        } else {
            editing = true
            caret = char_count()
        }
    }
    // Left/right move the caret while editing; up/down stop editing and return false so the focus moves.
    fn nudge(dir: vec2) -> bool {
        if !editing {
            return false
        }
        if dir.x != 0.0 {
            set_caret(caret + (dir.x < 0.0 ? -1 : 1))
            return true
        }
        editing = false
        return false
    }
    // ui_cancel: stops editing and returns true; false if it wasn't editing.
    fn on_cancel() -> bool {
        if editing {
            editing = false
            return true
        }
        return false
    }
    // Clicking starts editing and puts the caret where it landed.
    fn pointer_down(p: vec2) {
        if !editable {
            return
        }
        editing = true
        var t = get_theme()
        var shown = display_text().chars()
        var rel = p.x - (position.x + t.padding.x) + text_offset()
        var best = 0
        var best_d = abs(rel)
        for i in 1..(shown.len() + 1) {
            var d = abs(UI.measure("".join(shown.slice(0, i)), t.font_size).x - rel)
            if d < best_d {
                best = i
                best_d = d
            }
        }
        caret = best
    }
    // Stops editing when focus is lost or the field is disabled, and asks the window for text input while editing.
    fn update(dt: float) {
        if editing && (!has_focus() || disabled) {
            editing = false
        }
        if editing {
            UI.wants_text(true)
        }
    }
    // The text as drawn: `text`, or one "*" per character when `secret`.
    fn display_text() -> str {
        return secret ? "*".repeat(char_count()) : text
    }
    // Wide enough for about twelve characters, plus padding.
    fn content_min_size() -> vec2 {
        var t = get_theme()
        return UI.measure("MMMMMMMMMMMM", t.font_size) + t.padding * 2.0
    }
    // Pixels the text is shifted left so the caret stays inside the field.
    fn text_offset() -> float {
        var t = get_theme()
        var shown = display_text().chars()
        var cx = UI.measure("".join(shown.slice(0, min(caret, shown.len()))), t.font_size).x
        return max(cx - (size.x - t.padding.x * 2.0 - 4.0), 0.0)
    }
    // Draws the field, the text or placeholder scrolled to keep the caret visible, and a blinking caret while editing.
    fn draw(g: Canvas) {
        var t = get_theme()
        var focus = has_focus()
        g.rect(position, size, fill = editing ? t.panel : (focus ? t.button_focus : t.button),
               stroke = editing ? t.gold : (focus ? t.accent : t.panel_border), width = t.border, radius = t.radius)
        var inner_pos = position + vec2(t.padding.x, 0.0)
        var inner_size = vec2(max(size.x - t.padding.x * 2.0, 1.0), size.y)
        var mid = position.y + size.y * 0.5
        UI.push_clip(g, inner_pos, inner_size)
        var off = text_offset()
        if text == "" && !editing {
            g.text(vec2(inner_pos.x, mid), placeholder, size = t.font_size, color = t.text_disabled, baseline = #middle)
        } else {
            g.text(vec2(inner_pos.x - off, mid), display_text(), size = t.font_size,
                   color = disabled ? t.text_disabled : t.text, baseline = #middle)
        }
        if editing && (Time.tick / 30) % 2 == 0 {
            var shown = display_text().chars()
            var cx = UI.measure("".join(shown.slice(0, min(caret, shown.len()))), t.font_size).x
            var x = inner_pos.x - off + cx
            g.line(vec2(x, mid - t.font_size * 0.6), vec2(x, mid + t.font_size * 0.6), color = t.gold, width = 2.0)
        }
        UI.pop_clip(g)
    }
}

// A row of tab titles; the current one is highlighted. ui_left/right (while
// the bar has the focus) and the pointer switch tabs. TabContainer wraps a
// TabBar around pages.
class TabBar extends Control {
    // The titles.
    @export var tabs = List<str>()
    // The selected tab.
    @export var current = 0
    // Every tab is at least this wide (also makes tab positions independent
    // of the font, e.g. for replays checked on a host without one).
    @export var min_tab_width = 0.0
    // `current` changed; `index` is the new tab.
    signal tab_changed(index: int)

    // Focusable unless disabled or empty.
    fn can_focus() -> bool {
        return !disabled && tabs.len() > 0
    }
    // Width of tab `i`: its title plus padding, at least `min_tab_width`.
    fn tab_width(i: int) -> float {
        var t = get_theme()
        return max(UI.measure(tabs[i], t.font_size).x + t.padding.x * 2.0, min_tab_width)
    }
    // Left edge of tab `i` relative to the bar.
    fn tab_x(i: int) -> float {
        var x = 0.0
        for k in 0..i {
            x += tab_width(k) + 4.0
        }
        return x
    }
    // Selects tab `i` (clamped), emitting `tab_changed` when it changed.
    fn set_current(i: int) {
        if tabs.len() == 0 {
            return
        }
        var x = clamp(i, 0, tabs.len() - 1)
        if x != current {
            current = x
            emit tab_changed(x)
        }
    }
    // The tab under x (a screen coordinate), or -1.
    fn tab_at(x: float) -> int {
        for i in 0..tabs.len() {
            var left = position.x + tab_x(i)
            if x >= left && x < left + tab_width(i) {
                return i
            }
        }
        return -1
    }
    // Left/right select the previous/next tab; false at the ends or for other directions.
    fn nudge(dir: vec2) -> bool {
        if dir.x == 0.0 || disabled {
            return false
        }
        var to = current + (dir.x < 0.0 ? -1 : 1)
        if to < 0 || to >= tabs.len() {
            return false
        }
        set_current(to)
        return true
    }
    // Selects the tab under the pointer.
    fn pointer_down(p: vec2) {
        var i = tab_at(p.x)
        if i >= 0 {
            set_current(i)
        }
    }
    // Does nothing: tabs change by nudge or pointer.
    fn activate() {}
    // Total width of the tabs and one text line plus padding in height.
    fn content_min_size() -> vec2 {
        var t = get_theme()
        var w = 0.0
        for i in 0..tabs.len() {
            w += tab_width(i) + 4.0
        }
        return vec2(w, t.font_size + t.padding.y * 2.0)
    }
    // Draws the tabs, marking the current one.
    fn draw(g: Canvas) {
        var t = get_theme()
        var focus = has_focus()
        for i in 0..tabs.len() {
            var x = position.x + tab_x(i)
            var w = tab_width(i)
            var sel = i == current
            g.rect(vec2(x, position.y), vec2(w, size.y), fill = sel ? t.button_focus : t.button,
                   stroke = sel && focus ? t.accent : t.panel_border, width = t.border, radius = t.radius)
            if sel {
                g.rect(vec2(x + 6.0, position.y + size.y - 4.0), vec2(w - 12.0, 3.0), fill = t.accent, radius = 1.5)
            }
            g.text(vec2(x + w * 0.5, position.y + size.y * 0.5), tabs[i], size = t.font_size,
                   color = sel ? t.accent : t.text_dim, align = #center, baseline = #middle)
        }
    }
}

// A TabBar above pages: the Control children (except its bar) are the pages,
// and only the current one is shown. Titles come from `titles` (by index) or
// else the page's `name`. ui_tab_prev / ui_tab_next (shoulder buttons,
// optional actions) switch tabs while the focus is anywhere in the same UI root.
class TabContainer extends Container {
    // The selected page.
    @export var current = 0
    // Titles by page index; an empty or missing title uses the page's name.
    @export var titles = List<str>()
    // The bar's `min_tab_width`.
    @export var tab_min_width = 0.0
    // `current` changed; `index` is the new page.
    signal tab_changed(index: int)

    // The tab bar, created in ready().
    var bar: TabBar

    // Creates the TabBar and syncs the pages.
    fn ready() {
        bar = TabBar()
        bar.transient = true
        bar.name = "tab_bar"
        add_child(bar)
        bar.tab_changed.connect(fn(i: int) {
            set_current(i)
        })
        sync_pages()
    }
    // The pages: laid-out Controls other than the bar. Hidden pages count.
    fn pages() -> List<Control> {
        var out = List<Control>()
        for c in children {
            if c is Control k && k != bar && !k.floating() {
                out.push(k)
            }
        }
        return out
    }
    // Brings the bar's titles and the pages' visibility up to date. Without a bar (the editor's preview
    // builds a scene without running ready()) the pages still show one at a time.
    fn sync_pages() {
        var list = pages()
        current = list.len() == 0 ? 0 : clamp(current, 0, list.len() - 1)
        if bar != null {
            var names = List<str>()
            for i in 0..list.len() {
                names.push(i < titles.len() && titles[i] != "" ? titles[i] : list[i].name)
            }
            if names != bar.tabs {
                bar.tabs = names
            }
            bar.min_tab_width = tab_min_width
            bar.current = current
        }
        for i in 0..list.len() {
            list[i].visible = i == current
        }
    }
    // Shows page `i` (clamped), emitting `tab_changed` when it changed.
    fn set_current(i: int) {
        var list = pages()
        if list.len() == 0 {
            return
        }
        var x = clamp(i, 0, list.len() - 1)
        if x != current {
            current = x
            sync_pages()
            emit tab_changed(x)
        }
    }
    // Switches pages with ui_tab_prev / ui_tab_next while the focus is in the same UI root.
    fn update(dt: float) {
        if UI.focused != null && UI.focused.root_control() == root_control() && UI.modal_allows(self) {
            if Input.pressed(#ui_tab_prev) {
                set_current(current - 1)
            }
            if Input.pressed(#ui_tab_next) {
                set_current(current + 1)
            }
        }
    }
    // The largest page (or bar width) wide; the bar plus the tallest page high.
    fn content_min_size() -> vec2 {
        var m = vec2(0.0, 0.0)
        for k in pages() {
            m = m.max(k.combined_min_size())
        }
        var b = bar == null ? vec2(0.0, 0.0) : bar.combined_min_size()
        return vec2(max(m.x, b.x), m.y + b.y + get_theme().separation * 0.5)
    }
    // Places the bar on top and the current page below it.
    fn layout_children() {
        sync_pages()
        var top = 0.0
        if bar != null {
            var b = bar.combined_min_size()
            bar.set_rect(position, vec2(size.x, b.y))
            top = b.y + get_theme().separation * 0.5
        }
        for k in pages() {
            if k.visible {
                k.set_rect(position + vec2(0.0, top), vec2(size.x, max(size.y - top, 0.0)))
            }
        }
    }
}

// ---------------------------------------------------------------- popups

// A panel that floats above the UI as a root of its own. Open it with
// popup_centered() or popup_at(); close() hides it. While open and `modal`,
// it traps the focus and input (UI.modal) and a dimmed backdrop covers the
// rest; the previous focus comes back on close. ui_cancel closes it
// (`cancel_closes`), and with `light_dismiss` so does a click outside (menus).
// It may be a child of any control: its parent doesn't lay it out.
class Popup extends Panel {
    // Takes all input while open and dims what is behind.
    @export var modal = true
    // A click outside closes it.
    @export var light_dismiss = false
    // ui_cancel closes it.
    @export var cancel_closes = true
    // Open: visible. The control that takes the focus on opening (null: the first focusable).
    var initial_focus: Control
    // Opened / closed (by close(), ui_cancel or a click outside).
    signal opened
    // Emitted when it closes.
    signal closed

    var _opened = false
    var _center = true
    var _at = vec2(0.0, 0.0)
    var _min_width = 0.0
    var _prev_focus: Control
    var _prev_modal: Node

    // Always floating: its parent doesn't lay it out.
    fn floating() -> bool {
        return true
    }
    // A popup is a UI root of its own.
    fn is_ui_root() -> bool {
        return true
    }
    // Whether it is currently open.
    fn is_open() -> bool {
        return _opened && visible
    }
    // Starts hidden unless already opened.
    fn ready() {
        if !_opened {
            visible = false
        }
    }
    // Opens it in the middle of the screen.
    fn popup_centered() {
        open(true, vec2(0.0, 0.0), 0.0)
    }
    // Opens it with its top-left corner at `pos` (moved to stay on screen),
    // at least `min_width` wide.
    fn popup_at(pos: vec2, min_width = 0.0) {
        open(false, pos, min_width)
    }
    // Shows it (centered or at `pos`, at least `min_width` wide), takes the modal state and moves the focus in; used by popup_centered() and popup_at().
    fn open(centered: bool, pos: vec2, min_width: float) {
        if is_open() {
            return
        }
        _opened = true
        visible = true
        _center = centered
        _at = pos
        _min_width = min_width
        _prev_focus = UI.focused
        if modal {
            _prev_modal = UI.modal
            UI.modal = self
        }
        // The press that opened it must not reach it.
        UI.consume_input()
        var list = List<Control>()
        collect_focusable(list)
        if initial_focus != null && initial_focus.is_alive() && initial_focus.can_focus() {
            UI.focused = initial_focus
        } else if list.len() > 0 {
            UI.focused = list[0]
        }
        emit opened
    }
    // Hides it and gives the focus back.
    fn close() {
        if !is_open() {
            return
        }
        visible = false
        _opened = false
        if UI.modal == self {
            UI.modal = _prev_modal
        }
        _prev_modal = null
        if UI.focused != null && root_control() == self {
            UI.focused = null
        }
        if _prev_focus != null && _prev_focus.is_alive() && _prev_focus.can_focus() && _prev_focus.is_visible_in_tree() {
            UI.focused = _prev_focus
        }
        _prev_focus = null
        emit closed
    }
    // Called on ui_cancel: closes it if `cancel_closes`, then emits `cancelled`.
    fn emit_cancelled() {
        if cancel_closes {
            close()
        }
        emit cancelled
    }
    // Handles clicks outside it: a modal or light-dismiss popup swallows them, and light_dismiss also closes it.
    fn on_root_input() {
        if UI.click_pending && !contains(UI.pointer_pos) && (modal || light_dismiss) {
            UI.click_pending = false
            if light_dismiss {
                close()
            }
        }
    }
    // Placed where it was opened, as small as its content allows, on screen.
    fn layout_in(parent_pos: vec2, parent_size: vec2) {
        var sz = combined_min_size().max(vec2(_min_width, 0.0)).min(Screen.size)
        var pos = _center ? (Screen.size - sz) * 0.5 : _at
        pos = pos.min(Screen.size - sz).max(vec2(0.0, 0.0))
        set_rect(pos, sz)
    }
    // Queues itself for the overlay layer instead of drawing in place when open.
    fn draw_tree(g: Canvas) {
        if visible && _opened {
            Scene.overlays.push(self)
        }
    }
    // Draws the dimmed backdrop (when modal), the popup and its children above everything else.
    fn draw_overlay(g: Canvas) {
        if !visible {
            return
        }
        if modal {
            g.rect(vec2(0.0, 0.0), Screen.size, fill = Color.hex("05071080"))
        }
        draw(g)
        for c in children {
            c.draw_tree(g)
        }
    }
}

// A popup listing `items` as buttons; choosing one emits `item_chosen` and
// closes it. It is what OptionButton opens, and works as a context menu.
class PopupMenu extends Popup {
    // The entries.
    @export var items = List<str>()
    // The entry that takes the focus when it opens (-1: the first).
    @export var selected = -1
    // At least this size for every entry button (a fixed size keeps the menu
    // independent of the font).
    @export var item_min_size = vec2(0.0, 0.0)
    // `index` was chosen.
    signal item_chosen(index: int)

    var _box: VBox
    var _buttons = List<Button>()

    // Less padding than a dialog panel.
    fn inset() -> vec4 {
        return margins + vec4(10.0)
    }

    // Sets light dismissal and creates the box that holds the entry buttons.
    fn ready() {
        super.ready()
        light_dismiss = true
        _box = VBox()
        _box.transient = true
        _box.separation = 4.0
        add_child(_box)
    }
    // Open as a dropdown below `pos`.
    fn popup_menu(pos: vec2, min_width = 0.0) {
        rebuild()
        popup_at(pos, min_width)
        if selected >= 0 && selected < _buttons.len() {
            UI.focused = _buttons[selected]
        }
    }
    // Brings the entry buttons up to date with `items`: adds missing ones, sets text and size, hides extras.
    fn rebuild() {
        while _buttons.len() < items.len() {
            var b = Button()
            b.transient = true
            var idx = _buttons.len()
            b.pressed.connect(fn() {
                choose(idx)
            })
            _box.add_child(b)
            _buttons.push(b)
        }
        for i in 0..items.len() {
            _buttons[i].text = items[i]
            _buttons[i].min_size = item_min_size
            _buttons[i].visible = true
        }
        var used = items.len()
        var total = _buttons.len()
        for i in used..total {
            _buttons[i].visible = false
        }
    }
    // Closes the menu and emits `item_chosen`.
    fn choose(index: int) {
        close()
        emit item_chosen(index)
    }
}

// A button showing the selected entry of `items`; pressing it opens a
// dropdown (PopupMenu) below it.
class OptionButton extends Control {
    // The entries.
    @export var items = List<str>()
    // The chosen entry, -1 for none.
    @export var selected = 0
    // At least this tall for every dropdown entry (0: the font's height).
    @export var item_height = 0.0
    // `selected` changed by the user or set_selected().
    signal item_selected(index: int)

    var _menu: PopupMenu

    // Focusable unless disabled.
    fn can_focus() -> bool {
        return !disabled
    }
    // The text of the chosen entry ("" for none).
    fn selected_text() -> str {
        return selected >= 0 && selected < items.len() ? items[selected] : ""
    }
    // Selects entry `index` (clamped, -1 for none), emitting `item_selected` when it changed.
    fn set_selected(index: int) {
        var x = clamp(index, -1, items.len() - 1)
        if x != selected {
            selected = x
            emit item_selected(x)
        }
    }
    // Whether the dropdown is open.
    fn is_open() -> bool {
        return _menu != null && _menu.is_open()
    }
    // Opens the dropdown below the button with the current entries; does nothing when disabled or empty.
    fn activate() {
        if disabled || items.len() == 0 {
            return
        }
        if _menu == null {
            _menu = PopupMenu()
            _menu.transient = true
            add_child(_menu)
            _menu.item_chosen.connect(fn(i: int) {
                set_selected(i)
            })
        }
        _menu.items = items
        _menu.item_min_size = vec2(0.0, item_height)
        _menu.selected = selected
        _menu.popup_menu(vec2(position.x, position.y + size.y + 2.0), size.x)
    }
    // The widest entry plus padding and room for the arrow, one line tall.
    fn content_min_size() -> vec2 {
        var t = get_theme()
        var w = 0.0
        for s in items {
            w = max(w, UI.measure(s, t.font_size).x)
        }
        return vec2(w, UI.measure("M", t.font_size).y) + t.padding * 2.0 + vec2(28.0, 0.0)
    }
    // Draws the button with the selected text and a dropdown arrow.
    fn draw(g: Canvas) {
        var t = get_theme()
        var focus = has_focus() || is_open()
        g.rect(position, size, fill = focus ? t.button_focus : t.button, stroke = focus ? t.accent : t.panel_border,
               width = t.border, radius = t.radius)
        var color = disabled ? t.text_disabled : (focus ? t.accent : t.text)
        g.text(vec2(position.x + t.padding.x, position.y + size.y * 0.5), selected_text(), size = t.font_size,
               color = color, baseline = #middle)
        var c = vec2(position.x + size.x - t.padding.x - 4.0, position.y + size.y * 0.5)
        g.line(c + vec2(-7.0, -3.0), c + vec2(0.0, 4.0), color = color, width = 2.5)
        g.line(c + vec2(0.0, 4.0), c + vec2(7.0, -3.0), color = color, width = 2.5)
    }
}

// A modal dialog with a title, a message and OK / Cancel buttons. Open it
// with popup_centered(); `confirmed` fires for OK, `cancelled` for Cancel or
// ui_cancel. The focus starts on Cancel (`focus_ok` puts it on OK).
class ConfirmDialog extends Popup {
    // Title line.
    @export var title = "Confirm"
    // Message text.
    @export var message = ""
    // Text of the OK button.
    @export var ok_text = "OK"
    // Text of the Cancel button.
    @export var cancel_text = "Cancel"
    // true: the focus starts on OK instead of Cancel.
    @export var focus_ok = false
    // OK was pressed.
    signal confirmed

    var _title: Label
    var _message: Label
    var _ok: Button
    var _cancel: Button

    // Builds the title, message and the two buttons.
    fn ready() {
        super.ready()
        var box = VBox()
        box.transient = true
        box.separation = 16.0
        _title = Label()
        _title.style = #accent
        _title.min_size = vec2(0.0, 36.0)
        _message = Label()
        _message.min_size = vec2(0.0, 32.0)
        var row = HBox()
        row.separation = 16.0
        _ok = Button()
        _ok.min_size = vec2(140.0, 44.0)
        _cancel = Button()
        _cancel.min_size = vec2(140.0, 44.0)
        _ok.pressed.connect(fn() {
            close()
            emit confirmed
        })
        _cancel.pressed.connect(fn() {
            emit_cancelled()
        })
        row.add_child(_ok)
        row.add_child(_cancel)
        box.add_child(_title)
        box.add_child(_message)
        box.add_child(row)
        add_child(box)
        sync_text()
        initial_focus = focus_ok ? _ok : _cancel
    }
    // Copies title, message and button texts into their labels.
    fn sync_text() {
        _title.text = title
        _message.text = message
        _ok.text = ok_text
        _cancel.text = cancel_text
    }
    // Refreshes the texts and initial focus, then opens it in the middle of the screen.
    fn popup_centered() {
        sync_text()
        initial_focus = focus_ok ? _ok : _cancel
        super.popup_centered()
    }
}


// ---------------------------------------------------------------- focus and input

// Per-tick UI input state that is not part of the state hash: the hash covers
// every numeric static, and widgets added after the first UI (DESIGN.md 4.17,
// 9.3) keep their counters in this object so existing replays stay valid.
class UIExtra {
    // Ticks the current control has had the focus.
    var focus_ticks = 0
    // Ticks the focus must rest before a tooltip shows.
    var tooltip_delay = 24
    // Scrolling: -1 up, 1 down, 0 none, and whether it started this tick.
    var scroll_dir = 0.0
    // Whether a scroll press started this tick.
    var scroll_first = false
    // Ticks the scroll key has been held.
    var scroll_ticks = 0
    // Repeating edit keys (ui_backspace, ui_delete, ui_home, ui_end).
    var backspace_pressed = false
    // ui_delete was pressed (or repeated) this tick.
    var delete_pressed = false
    // ui_home was pressed this tick.
    var home_pressed = false
    // ui_end was pressed this tick.
    var end_pressed = false
    // Ticks ui_backspace has been held.
    var bs_ticks = 0
    // Ticks ui_delete has been held.
    var del_ticks = 0
}

// Focus, modal state and input handling shared by every UI tree; all static.
class UI {
    // Ticks the focus has rested (focus_ticks), the tooltip delay, scrolling
    // and edit-key state.
    static var x = UIExtra()
    // The default theme.
    static var theme = Theme()
    // The control with the focus, or null.
    static var focused: Control
    // The control being dragged (a slider, a scroll area), or null.
    static var dragging: Control
    // When set, only UI roots under this node take input (a modal dialog
    // over other menus). Popup sets and restores it.
    static var modal: Node
    // Ticks the current control has had the focus, and how many a tooltip waits.

    // Per-tick input state, computed by the first root that runs in a tick
    // and consumed by the root that uses it.
    static var _tick = -1
    // The pointer position this tick; used by the UI internals.
    static var pointer_pos = vec2(-1.0, -1.0)
    static var _pointer_moved = false
    // A click happened this tick and no control has taken it yet; used by the UI internals.
    static var click_pending = false
    static var _nav = vec2(0.0, 0.0)
    static var _accept = false
    static var _cancel = false
    static var _hold_dir = vec2(0.0, 0.0)
    static var _hold_ticks = 0
    static var _last_focus: Control
    // Scrolling: -1 up, 1 down, 0 none, and whether it started this tick.
    // Text editing: the character typed this tick ("" if none) and the
    // repeating edit keys (actions ui_backspace, ui_delete, ui_home, ui_end).
    static var typed_text = ""
    // Intersected clip rectangles (x, y, width, height) of the scroll areas being drawn.
    static var _clips = List<vec4>()

    // Size of `text` laid out with the game's font at `size` (one line per
    // '\n'): the width of the widest line and the height of all lines.
    @native static fn measure(text: str, size: float) -> vec2 {}
    // The natural size of a vector image file in the project (Image), or
    // (0, 0) if it can't be read.
    @native static fn image_size(asset: str) -> vec2 {}
    // Called while a text field is being edited, every tick: the window then
    // delivers typed text (and raises an on-screen keyboard where there is one).
    @native static fn wants_text(on: bool) {}

    // True when `n` may take input given UI.modal.
    static fn modal_allows(n: Node) -> bool {
        return modal == null || !modal.is_alive() || is_under(n, modal)
    }

    // Cuts drawing to the rectangle (intersected with the clip in effect)
    // until the matching pop_clip().
    static fn push_clip(g: Canvas, pos: vec2, sz: vec2) {
        var x0 = pos.x
        var y0 = pos.y
        var x1 = pos.x + sz.x
        var y1 = pos.y + sz.y
        if _clips.len() > 0 {
            var top = _clips[_clips.len() - 1]
            x0 = max(x0, top.x)
            y0 = max(y0, top.y)
            x1 = min(x1, top.x + top.z)
            y1 = min(y1, top.y + top.w)
        }
        var r = vec4(x0, y0, max(x1 - x0, 0.0), max(y1 - y0, 0.0))
        _clips.push(r)
        g.set_clip(vec2(r.x, r.y), vec2(r.z, r.w))
    }
    // Ends the clip started by the matching push_clip().
    static fn pop_clip(g: Canvas) {
        if _clips.len() == 0 {
            return
        }
        _clips.pop()
        if _clips.len() > 0 {
            var top = _clips[_clips.len() - 1]
            g.set_clip(vec2(top.x, top.y), vec2(top.z, top.w))
        } else {
            g.clear_clip()
        }
    }

    // UI internals, run by the UI roots: per-tick input, focus moves, clicks.
    static fn begin_tick() {
        if _tick == Time.tick {
            return
        }
        _tick = Time.tick
        var p = Input.pointer()
        _pointer_moved = p != pointer_pos
        pointer_pos = p
        click_pending = Input.pressed(#ui_click)
        _accept = Input.pressed(#ui_accept)
        _cancel = Input.pressed(#ui_cancel)
        if focused == _last_focus {
            x.focus_ticks += 1
        } else {
            _last_focus = focused
            x.focus_ticks = 0
        }
        var dir = vec2(0.0, 0.0)
        if Input.held(#ui_up) {
            dir = vec2(0.0, -1.0)
        } else if Input.held(#ui_down) {
            dir = vec2(0.0, 1.0)
        } else if Input.held(#ui_left) {
            dir = vec2(-1.0, 0.0)
        } else if Input.held(#ui_right) {
            dir = vec2(1.0, 0.0)
        }
        _nav = vec2(0.0, 0.0)
        if dir != _hold_dir {
            _hold_dir = dir
            _hold_ticks = 0
            _nav = dir
        } else if dir != vec2(0.0, 0.0) {
            // Key repeat: after 0.4 s, every 0.1 s (at 60 Hz).
            _hold_ticks += 1
            if _hold_ticks >= 24 && (_hold_ticks - 24) % 6 == 0 {
                _nav = dir
            }
        }
        // Scrolling (the wheel is "held" on the tick it moved).
        x.scroll_dir = 0.0
        if Input.held(#ui_scroll_down) {
            x.scroll_dir = 1.0
        } else if Input.held(#ui_scroll_up) {
            x.scroll_dir = -1.0
        }
        if x.scroll_dir != 0.0 {
            x.scroll_ticks += 1
        } else {
            x.scroll_ticks = 0
        }
        x.scroll_first = x.scroll_ticks == 1
        // Text editing.
        typed_text = Input.text()
        x.bs_ticks = Input.held(#ui_backspace) ? x.bs_ticks + 1 : 0
        x.backspace_pressed = x.bs_ticks == 1 || (x.bs_ticks >= 24 && (x.bs_ticks - 24) % 6 == 0)
        x.del_ticks = Input.held(#ui_delete) ? x.del_ticks + 1 : 0
        x.delete_pressed = x.del_ticks == 1 || (x.del_ticks >= 24 && (x.del_ticks - 24) % 6 == 0)
        x.home_pressed = Input.pressed(#ui_home)
        x.end_pressed = Input.pressed(#ui_end)
    }

    // Drops this tick's UI input (e.g. after the key that opened a menu, so
    // the menu doesn't see the same press).
    static fn consume_input() {
        begin_tick()
        click_pending = false
        _accept = false
        _cancel = false
        _nav = vec2(0.0, 0.0)
        x.scroll_dir = 0.0
        typed_text = ""
        x.backspace_pressed = false
        x.delete_pressed = false
        x.home_pressed = false
        x.end_pressed = false
    }

    // True if `n` is `ancestor` or below it.
    static fn is_under(n: Node, ancestor: Node) -> bool {
        var x = n
        while x != null {
            if x == ancestor {
                return true
            }
            x = x.parent
        }
        return false
    }

    // Handles one tick of input for the UI tree under `root`: focus moves, activation, clicks and drags.
    static fn process(root: Control) {
        begin_tick()
        if modal != null && (!is_under(root, modal) || !modal.is_alive()) {
            if modal.is_alive() {
                return
            }
            modal = null
        }
        if focused != null && (!focused.is_alive() || !focused.can_focus() || !focused.is_visible_in_tree()) {
            focused = null
        }
        root.on_root_input()
        // Pointer: hovering focuses, clicking activates; a click on empty
        // content of a scroll area starts dragging the content.
        if _pointer_moved || click_pending {
            var hit = root.focusable_at(pointer_pos)
            if hit != null {
                if _pointer_moved {
                    focused = hit
                }
                if click_pending {
                    click_pending = false
                    focused = hit
                    dragging = hit
                    hit.pointer_down(pointer_pos)
                }
            } else if click_pending {
                var area = root.find_scroll(pointer_pos, 0.0)
                if area != null {
                    click_pending = false
                    dragging = area
                    area.pointer_down(pointer_pos)
                }
            }
        }
        if dragging != null && dragging.root_control() == root {
            if Input.held(#ui_click) && dragging.is_alive() {
                dragging.pointer_drag(pointer_pos)
            } else {
                dragging = null
            }
        }
        // Scrolling: the area under the pointer, else the one around the focus.
        if x.scroll_dir != 0.0 {
            var area = root.find_scroll(pointer_pos, x.scroll_dir)
            if area == null && focused != null && focused.root_control() == root {
                area = root.find_scroll(focused.center(), x.scroll_dir)
            }
            if area == null && focused != null && focused.root_control() == root {
                area = root.find_any_scroll(x.scroll_dir)
            }
            if area != null {
                var amount = x.scroll_dir * area.scroll_step() * (x.scroll_first ? 1.0 : 0.25)
                x.scroll_dir = 0.0
                area.scroll_by(vec2(0.0, amount))
            }
        }
        // Keys and gamepad.
        var inside = focused != null && focused.root_control() == root
        if inside && focused.is_editing() {
            focused.edit_tick()
            if typed_text != "" {
                // The key that typed the character isn't a command.
                _nav = vec2(0.0, 0.0)
                _accept = false
                _cancel = false
            }
        }
        if focused == null && (_nav != vec2(0.0, 0.0) || _accept) {
            var list = List<Control>()
            root.collect_focusable(list)
            if list.len() > 0 {
                focused = list[0]
                _nav = vec2(0.0, 0.0)
                _accept = false
            }
        } else if inside {
            if _nav != vec2(0.0, 0.0) {
                var dir = _nav
                _nav = vec2(0.0, 0.0)
                if !focused.nudge(dir) {
                    var n = neighbor(root, focused, dir)
                    if n != null {
                        focused = n
                    }
                }
            }
            if _accept {
                _accept = false
                focused.activate()
            }
        }
        if _cancel && (inside || focused == null) {
            _cancel = false
            var used = false
            if inside && focused != null {
                used = focused.on_cancel()
            }
            if !used {
                root.emit_cancelled()
            }
        }
    }

    // The focusable control of `root` nearest to `from` in direction `dir`,
    // wrapping to the far end when there is none that way.
    static fn neighbor(root: Control, from: Control, dir: vec2) -> Control {
        var list = List<Control>()
        root.collect_focusable(list)
        var origin = from.center()
        var best: Control
        var best_score = 0.0
        for c in list {
            if c == from {
                continue
            }
            var d = c.center() - origin
            var along = d.dot(dir)
            if along <= 1.0 {
                continue
            }
            var score = along + abs(d.x * dir.y - d.y * dir.x) * 2.0
            if best == null || score < best_score {
                best = c
                best_score = score
            }
        }
        if best != null {
            return best
        }
        for c in list {
            if c == from {
                continue
            }
            var d = c.center() - origin
            var along = d.dot(dir)
            if along >= -1.0 {
                continue
            }
            var score = along + abs(d.x * dir.y - d.y * dir.x) * 2.0
            if best == null || score < best_score {
                best = c
                best_score = score
            }
        }
        return best
    }
}
