# Phase 11 capstone, one run per language (examples/showcase_duel): the localized HUD, the sprite scene
# and the custom post-process pass render headless on GL with no warnings; each run repeats its state hash
# and its frame on 1 and 8 job threads; the three languages draw three different frames; and each
# recording verifies when the editor is built. (The language keys are part of the recorded input, so the
# hashes differ between languages by design.)
# Invoked by ctest with -DCUERVO=... -DGAME=... -DOUT=... [-DEDITOR=...]

file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(ENV{SDL_VIDEO_DRIVER} offscreen)
set(ENV{CUERVO_AUDIO} null)

set(play "10-400:shoot,100-130:right,150-200:up,220-260:left")
set(tick 300)
# name | extra presses (the `lang` key is pressed once per step from the language the run starts in)
set(runs "en|" "ar|5:lang" "ja|5:lang,8:lang")

function(run name press jobs out_hash)
    set(args --game "${GAME}" --backend gl --no-audio --vsync off --jobs ${jobs}
             --press "${press}" --screenshot "${OUT}/${name}_${jobs}.ppm" --screenshot-tick ${tick}
             --record "${OUT}/${name}_${jobs}.replay")
    execute_process(COMMAND "${CUERVO}" ${args} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    string(REGEX MATCH "at tick ${tick} \\(state hash ([0-9a-f]+)\\)" m "${out}${err}")
    set(hash "${CMAKE_MATCH_1}")
    if(NOT code EQUAL 0 OR hash STREQUAL "")
        message(FATAL_ERROR "${name}: cuervo failed (${code}):\n${out}\n${err}")
    endif()
    if("${out}${err}" MATCHES "\\[warn|\\[error|panic")
        message(FATAL_ERROR "${name}: warnings or errors while running:\n${out}\n${err}")
    endif()
    set(${out_hash} "${hash}" PARENT_SCOPE)
endfunction()

set(seen_images "")
foreach(spec IN LISTS runs)
    string(REPLACE "|" ";" parts "${spec}")
    list(GET parts 0 name)
    list(LENGTH parts n)
    set(press "${play}")
    if(n GREATER 1)
        list(GET parts 1 extra)
        if(NOT extra STREQUAL "")
            set(press "${extra},${play}")
        endif()
    endif()
    run(${name} "${press}" 1 hash1)
    run(${name} "${press}" 8 hash8)
    if(NOT hash1 STREQUAL hash8)
        message(FATAL_ERROR "${name}: state hash ${hash1} on 1 job, ${hash8} on 8")
    endif()
    file(READ "${OUT}/${name}_1.ppm" a HEX)
    file(READ "${OUT}/${name}_8.ppm" b HEX)
    if(NOT a STREQUAL b)
        message(FATAL_ERROR "${name}: the frame differs between 1 and 8 job threads")
    endif()
    file(SHA256 "${OUT}/${name}_1.ppm" image_hash)
    if(image_hash IN_LIST seen_images)
        message(FATAL_ERROR "${name}: the frame equals another language's: the locale did not change the HUD")
    endif()
    list(APPEND seen_images "${image_hash}")
    if(DEFINED EDITOR AND NOT EDITOR STREQUAL "")
        execute_process(COMMAND "${EDITOR}" --project "${GAME}" --replay-verify "${OUT}/${name}_1.replay" --jobs 1
            RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
        string(REGEX MATCH "final state hash ([0-9a-f]+)" m3 "${out}${err}")
        if(NOT code EQUAL 0 OR NOT CMAKE_MATCH_1 STREQUAL hash1)
            message(FATAL_ERROR "${name}: --replay-verify failed (${code}) or ended at ${CMAKE_MATCH_1}, not ${hash1}:\n${out}\n${err}")
        endif()
    endif()
    message(STATUS "${name}: tick ${tick} state hash ${hash1}; identical on 1 and 8 jobs")
endforeach()
