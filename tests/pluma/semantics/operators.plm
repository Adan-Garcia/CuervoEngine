// Operator precedence, associativity and compound assignment (LANGUAGE.md 4.1).
{
    // precedence
    print(1 + 2 * 3 - 4 / 2)
    print(2 * 3 % 4)
    print(1 << 2 + 1)
    print(6 & 3 == 2)
    print(1 | 2 ^ 3 & 4)
    print(5 & 3 | 8)
    print(-2 as float)
    print(-2 * 3)
    print(!true == false)
    print(1 + 2 < 4)
    print(1 < 2 == true)
    print(true || false && false)
    print(false && true || true)
    print(true ? 1 : false ? 2 : 3)
    print(~1 + 1)
    print(-1 << 1)
    print(2 + 3 as float)
}
{
    // as binds tighter than *
    print(3 as float * 2.0)
    print(10 / 3 as float)
}
{
    // range in expression
    for i in 0..2 + 2 { print(i) }
    var n = 3
    for i in 0..n * 2 step n { print(i) }
}
{
    // else if chain
    var n = 5
    if n < 3 {
        print("a")
    } else if n < 6 {
        print("b")
    } else {
        print("c")
    }
}
{
    // compound ops
    var a = 10
    a -= 3
    a *= 2
    a /= 4
    a %= 2
    a <<= 3
    a |= 1
    a ^= 3
    a &= 6
    a >>= 1
    print(a)
    var s = "a"
    s += "b"
    print(s)
    var f = 1.5
    f *= 2.0
    f /= 4.0
    print(f)
    var b = true
    b &= false
    b |= true
    print(b)
}
